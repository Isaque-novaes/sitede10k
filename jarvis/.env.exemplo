# Chaves do Jarvis. Copie este arquivo para ".env" e preencha. Nunca envie o .env para o GitHub.
# Google Cloud (projeto COM faturamento, com limite diário configurado): Places API (New) e PageSpeed Insights API
GOOGLE_API_KEY=
# Google AI Studio (projeto SEM faturamento, para continuar grátis)
GEMINI_API_KEY=
# Meta para desenvolvedores: token de longa duração e o ID da conta do Instagram do Estúdio Dez
META_TOKEN=
META_IG_USER_ID=
# pexels.com/api
PEXELS_API_KEY=
# GitHub: token fino só com escrita no repositório das prévias
GITHUB_TOKEN=
# dono/repositório das prévias, por exemplo isaque-novaes/previas
GITHUB_REPO=
GITHUB_RAMO=
# Opcional: endereço próprio das prévias (domínio apontado para o GitHub Pages)
BASE_URL_PREVIAS=
# Opcionais: trocar o modelo do Gemini ou a versão da API da Meta
GEMINI_MODELO=
META_VERSAO=
