Textos.dados = T

function Textos.idiomaDe(localeId)
	if type(localeId) == "string" and string.sub(string.lower(localeId), 1, 2) == "pt" then
		return "pt"
	end
	return "en"
end

function Textos.t(idioma, chave, ...)
	local entrada = T[chave]
	if not entrada then
		return chave
	end
	local texto = entrada[idioma] or entrada.en or entrada.pt
	local valores = { ... }
	texto = string.gsub(texto, "{(%d+)}", function(n)
		local v = valores[tonumber(n)]
		if v == nil then
			return ""
		end
		return tostring(v)
	end)
	return texto
end

return Textos
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000000000000000000000000000013"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000000000000000000000000000012"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000004"><Properties><string name="Name">Conveyor</string><ProtectedString name="Source"><![CDATA[--[[
	A esteira da fábrica: sorteia robôs, faz eles andarem e cuida da
	compra. Também controla a "Hora da Sorte" (grátis a cada 10 minutos,
	ou comprada por alguém para o servidor inteiro).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Game = require(script.Parent:WaitForChild("Game"))

local Conveyor = {}

local ativos = {} -- robôs na esteira, em ordem de criação
local aleatorio = Random.new()
local FRENTE = CFrame.Angles(0, -math.pi / 2, 0) -- olhando para +X (sentido da esteira)
local sorteAte = 0

function Conveyor.sorteAtual()
	if Game.agora() < sorteAte then
		return Config.SORTE.FORCA
	end
	return 1
end

-- Começa (ou estende) a sorte. quem = nome de quem pagou (nil = evento grátis)
function Conveyor.iniciarSorte(segundos, quem)
	local inicio = math.max(Game.agora(), sorteAte)
	sorteAte = inicio + segundos
	ReplicatedStorage:SetAttribute("HoraDaSorteAte", sorteAte)
	ReplicatedStorage:SetAttribute("HoraDaSortePor", quem or "")
	local restante = Game.tempoTexto(sorteAte - Game.agora())
	if quem then
		Game.notificarTodos("alerta", "sorte_presente", quem, Config.SORTE.FORCA, restante)
	else
		Game.notificarTodos("alerta", "sorte_gratis", Config.SORTE.FORCA, restante)
	end
end

function Conveyor.gerar(x)
	local esteira = Game.mundo.esteira
	x = x or esteira.inicioX
	local def, mutacaoId = Config.sortear(Conveyor.sorteAtual(), aleatorio)
	local robo = Game.novoRobo(def, mutacaoId, CFrame.new(x, esteira.y, esteira.z) * FRENTE)
	robo.x = x
	table.insert(ativos, robo)

	if def.raridade >= 5 or mutacaoId == "diamante" or mutacaoId == "arcoiris" then
		Game.notificarTodos("alerta", "saiu_fabrica", Game.nomeRobo(def, mutacaoId), Game.nomeRaridade(def.raridade))
	end
	return robo
end

function Conveyor.passo(dt)
	local esteira = Game.mundo.esteira
	local distancia = Config.ESTEIRA.VELOCIDADE * dt
	for i = #ativos, 1, -1 do
		local robo = ativos[i]
		if robo.estado ~= "esteira" then
			table.remove(ativos, i)
		else
			robo.x = robo.x + distancia
			if robo.x >= esteira.fimX then
				table.remove(ativos, i)
				Game.destruirRobo(robo)
			else
				robo.modelo:PivotTo(CFrame.new(robo.x, esteira.y, esteira.z) * FRENTE)
			end
		end
	end
end

function Conveyor.comprar(robo, player)
	local estado = Game.estados[player]
	if not estado or robo.estado ~= "esteira" then
		return
	end
	local vaga = Game.vagaLivre(estado)
	if not vaga then
		Game.notificar(player, "ruim", "base_cheia_compra")
		return
	end
	local preco = Config.precoDe(robo.def, robo.mut)
	if not Game.gastar(estado, preco) then
		Game.notificar(player, "ruim", "falta_dinheiro", Game.nomeRobo(robo.def, robo.mut), Game.dinheiroTexto(preco))
		return
	end
	Game.efeito("compra", robo.modelo:GetPivot().Position, Config.Raridades[robo.def.raridade].cor)
	Game.colocarNaBase(estado, robo, vaga, false)
	Game.notificar(player, "bom", "comprou", Game.nomeRobo(robo.def, robo.mut))
	Game.emitir(estado, "comprar", 1, { raridade = robo.def.raridade })
end

function Conveyor.quantidade()
	return #ativos
end

function Conveyor.robos()
	return ativos
end

function Conveyor.iniciar()
	Game.acoes.esteira = Conveyor.comprar
	ReplicatedStorage:SetAttribute("HoraDaSorteAte", 0)
	ReplicatedStorage:SetAttribute("HoraDaSortePor", "")

	-- já começa com a esteira cheia, para ninguém esperar
	local esteira = Game.mundo.esteira
	local espaco = Config.ESTEIRA.VELOCIDADE * Config.ESTEIRA.INTERVALO
	local x = esteira.fimX - espaco
	while x > esteira.inicioX do
		Conveyor.gerar(x)
		x = x - espaco
	end

	RunService.Heartbeat:Connect(Conveyor.passo)

	task.spawn(function()
		while true do
			Conveyor.gerar()
			task.wait(Config.ESTEIRA.INTERVALO)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.SORTE.A_CADA)
			Conveyor.iniciarSorte(Config.SORTE.DURACAO, nil)
		end
	end)
end

return Conveyor
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000005"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[--[[
	Salva e carrega o progresso com DataStore, do jeito seguro:

	- UpdateAsync (nunca GetAsync + SetAsync), com novas tentativas.
	- Trava de sessão: só um servidor por vez cuida dos dados de um jogador.
	  Isso impede o truque de duplicar robôs entrando em outro servidor
	  antes do primeiro terminar de salvar.
	- Versão dos dados: saves antigos são convertidos automaticamente.
	- Se a leitura falhar, o jogador é convidado a entrar de novo, em vez
	  de jogar com um perfil vazio que apagaria o progresso verdadeiro.

	No Roblox Studio o salvamento só funciona com "Game Settings > Security >
	Enable Studio Access to API Services". Sem isso o jogo roda sem salvar.
]]

local DataStoreService = game:GetService("DataStoreService")

local Data = {}

local NOME_DO_COFRE = "RoubaRobo_v1"
local VERSAO = 2
local TRAVA_VENCE = 600 -- segundos: uma trava mais velha que isso é de um servidor que caiu
local TENTATIVAS = 4

local cofre = nil
local okCofre, erroCofre = pcall(function()
	cofre = DataStoreService:GetDataStore(NOME_DO_COFRE)
end)
if not okCofre then
	warn("[Robot Heist] DataStore indisponível: " .. tostring(erroCofre))
end

local function chave(player)
	return "jogador_" .. player.UserId
end

local function copiar(valor)
	if type(valor) ~= "table" then
		return valor
	end
	local copia = {}
	for k, v in pairs(valor) do
		copia[k] = copiar(v)
	end
	return copia
end
Data.copiar = copiar

function Data.padrao()
	return {
		versao = VERSAO,
		dinheiro = nil, -- nil = usa o dinheiro inicial
		renascimentos = 0,
		robos = {}, -- { { id = "parafusinho", mut = "dourado", vaga = 1 }, ... }
		descobertos = {}, -- { parafusinho = true, ... }
		melhorias = { renda = 0, vagas = 0, tapa = 0 },
		diario = { sequencia = 0, ultimoDia = -1 },
		missoes = { dia = -1, progresso = {}, pegas = {} },
		saida = 0, -- os.time() da última saída (para o dinheiro offline)
		grupoPremiado = false,
		vipPremiado = false,
		indicePremios = {}, -- { ["4"] = true } raridades completas (chave texto)
		compras = {}, -- últimos PurchaseIds já entregues
		dobroAte = 0, -- os.time() até quando vale o x2 do anúncio
		totalGanho = 0, -- para o ranking
	}
end

-- Converte saves antigos para a versão atual (preenche o que falta).
function Data.migrar(dados)
	if type(dados) ~= "table" then
		return Data.padrao()
	end
	local padrao = Data.padrao()
	for k, v in pairs(padrao) do
		if dados[k] == nil then
			dados[k] = v
		end
	end
	for k, v in pairs(padrao.melhorias) do
		if type(dados.melhorias[k]) ~= "number" then
			dados.melhorias[k] = v
		end
	end
	if type(dados.diario) ~= "table" then
		dados.diario = padrao.diario
	end
	if type(dados.missoes) ~= "table" then
		dados.missoes = padrao.missoes
	end
	dados.versao = VERSAO
	return dados
end

local function travaAtiva(dados)
	local trava = type(dados) == "table" and dados.sessao
	return type(trava) == "table" and trava.id ~= game.JobId and (os.time() - (tonumber(trava.t) or 0)) < TRAVA_VENCE
end

local function semAcessoNoStudio(erro)
	local texto = tostring(erro)
	return string.find(texto, "Studio", 1, true) ~= nil or string.find(texto, "publish", 1, true) ~= nil
end

-- Retorna (dados, situacao):
--   "ok"      carregou e travou a sessão
--   "sem_api" Studio sem acesso: joga sem salvar
--   "ocupado" outro servidor ainda está salvando: pedir para entrar de novo
--   "falha"   o Roblox não respondeu: pedir para entrar de novo
function Data.carregar(player)
	if not cofre then
		return Data.padrao(), "sem_api"
	end
	local ocupado = false
	for tentativa = 1, TENTATIVAS + 2 do
		ocupado = false
		local ok, resultado = pcall(function()
			return cofre:UpdateAsync(chave(player), function(antigo)
				if travaAtiva(antigo) then
					ocupado = true
					return nil -- não mexe em dados que outro servidor está usando
				end
				local dados = Data.migrar(antigo or Data.padrao())
				dados.sessao = { id = game.JobId, t = os.time() }
				return dados
			end)
		end)
		if ok and not ocupado and type(resultado) == "table" then
			return Data.migrar(copiar(resultado)), "ok"
		end
		if not ok then
			if semAcessoNoStudio(resultado) then
				return Data.padrao(), "sem_api"
			end
			warn(string.format("[Robot Heist] Falha ao carregar %s (tentativa %d): %s",
				player.Name, tentativa, tostring(resultado)))
		end
		if player.Parent == nil then
			return nil, "falha"
		end
		task.wait(math.min(2 ^ tentativa, 8))
	end
	if ocupado then
		return nil, "ocupado"
	end
	return nil, "falha"
end

-- Salva. liberar = true solta a trava (o jogador saiu do servidor).
function Data.salvar(player, dados, liberar)
	if not cofre then
		return false
	end
	local paraSalvar = copiar(dados)
	paraSalvar.versao = VERSAO
	if liberar then
		paraSalvar.sessao = nil
	else
		paraSalvar.sessao = { id = game.JobId, t = os.time() }
	end
	for tentativa = 1, TENTATIVAS do
		local recusado = false
		local ok, erro = pcall(function()
			cofre:UpdateAsync(chave(player), function(antigo)
				if travaAtiva(antigo) then
					recusado = true
					return nil -- outro servidor assumiu: não sobrescreve
				end
				return paraSalvar
			end)
		end)
		if ok then
			if recusado then
				warn("[Robot Heist] Save de " .. player.Name .. " recusado: outro servidor tem a trava.")
				return false
			end
			return true
		end
		if semAcessoNoStudio(erro) then
			return false
		end
		warn(string.format("[Robot Heist] Falha ao salvar %s (tentativa %d): %s",
			player.Name, tentativa, tostring(erro)))
		if tentativa < TENTATIVAS then
			task.wait(math.min(2 ^ tentativa, 8))
		end
	end
	return false
end

return Data
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000006"><Properties><string name="Name">Game</string><ProtectedString name="Source"><![CDATA[--[[
	O coração do jogo no servidor: jogadores, bases, vagas, robôs,
	dinheiro, bônus, tranca da base e renascimento.

	Estados de um robô:
	  "esteira"   andando na esteira, à venda
	  "voando"    indo para uma base (animação)
	  "base"      parado num pedestal, gerando dinheiro
	  "carregado" na cabeça de um ladrão
	  "solto"     acabou de sair da cabeça do ladrão
	  "destruido" já saiu do jogo

	Conveyor e Stealing registram em Game.acoes o que acontece quando
	alguém segura E num robô em cada estado. Progresso ouve Game.emitir
	para contar as missões.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local Textos = require(Shared:WaitForChild("Textos"))
local MapBuilder = require(script.Parent:WaitForChild("MapBuilder"))
local RobotFactory = require(script.Parent:WaitForChild("RobotFactory"))

local Game = {}

Game.estados = {} -- [Player] = estado do jogador
Game.mundo = nil
Game.remotos = nil
Game.acoes = {} -- [estadoDoRobo] = function(robo, player)
Game.ouvintes = {} -- funções chamadas em Game.emitir

-- ganchos preenchidos pelo Stealing
Game.aoDestruirCarregado = nil -- function(robo)
Game.aoSairComCarga = nil -- function(estadoLadrao)

local MAIOR_INTEIRO = 9e18
local aleatorio = Random.new()

local function agora()
	return workspace:GetServerTimeNow()
end
Game.agora = agora

function Game.iniciar(mundo, remotos)
	Game.mundo = mundo
	Game.remotos = remotos
end

-- Eventos para missões ---------------------------------------------------------

function Game.emitir(estado, tipo, quantidade, info)
	for _, ouvinte in ipairs(Game.ouvintes) do
		ouvinte(estado, tipo, quantidade or 1, info)
	end
end

-- Avisos na tela, no idioma de cada jogador ----------------------------------
-- Argumentos que são funções recebem o idioma (ex.: nome do robô traduzido).

local function montarTexto(idioma, chave, ...)
	local valores = { ... }
	for i = 1, select("#", ...) do
		if type(valores[i]) == "function" then
			valores[i] = valores[i](idioma)
		end
	end
	return Textos.t(idioma, chave, table.unpack(valores, 1, select("#", ...)))
end

function Game.idiomaDe(player)
	local estado = Game.estados[player]
	if estado then
		return estado.idioma
	end
	return Textos.idiomaDe(player.LocaleId)
end

-- tipo: "bom", "ruim", "alerta" ou "info"
function Game.notificar(player, tipo, chave, ...)
	Game.remotos.Notificar:FireClient(player, montarTexto(Game.idiomaDe(player), chave, ...), tipo or "info")
end

function Game.notificarTodos(tipo, chave, ...)
	for player in pairs(Game.estados) do
		Game.notificar(player, tipo, chave, ...)
	end
end

function Game.efeito(tipo, posicao, cor)
	Game.remotos.Efeito:FireAllClients(tipo, posicao, cor)
end

-- Ajudantes para textos que dependem do idioma
function Game.nomeRobo(def, mut)
	return function(idioma)
		return Config.nomeCompleto(def, mut, idioma)
	end
end

function Game.nomeRaridade(raridade)
	return function(idioma)
		return Config.nomeDe(Config.Raridades[raridade], idioma)
	end
end

function Game.dinheiroTexto(valor)
	return function(idioma)
		return Format.dinheiro(valor, idioma)
	end
end

function Game.tempoTexto(segundos)
	return Format.tempo(segundos)
end

-- Robôs ------------------------------------------------------------------------

function Game.novoRobo(def, mutacaoId, cframe)
	local visual = RobotFactory.construir(def, mutacaoId)
	local robo = {
		def = def,
		mut = mutacaoId,
		modelo = visual.modelo,
		prompt = visual.prompt,
		visual = visual,
		estado = "esteira",
		dono = nil,
		vaga = nil,
		ladrao = nil,
		voo = 0,
	}
	visual.prompt.Triggered:Connect(function(player)
		local acao = Game.acoes[robo.estado]
		if acao then
			acao(robo, player)
		end
	end)
	visual.modelo:PivotTo(cframe)
	visual.modelo.Parent = Game.mundo.pastaRobos
	return robo
end

function Game.valorVenda(robo)
	return math.floor(Config.precoDe(robo.def, robo.mut) * Config.VENDA_DEVOLVE)
end

-- Anima o robô num arco até `alvo`. Um voo novo cancela o anterior.
function Game.voar(robo, alvo, aoTerminar)
	robo.voo = robo.voo + 1
	local meuVoo = robo.voo
	local inicio = robo.modelo:GetPivot()
	local distancia = (inicio.Position - alvo.Position).Magnitude
	local duracao = math.clamp(distancia / 70, 0.6, 2)
	local altura = math.clamp(distancia * 0.25, 4, 30)

	task.spawn(function()
		local comeco = os.clock()
		while true do
			if robo.voo ~= meuVoo or robo.modelo.Parent == nil then
				return
			end
			local t = math.min((os.clock() - comeco) / duracao, 1)
			robo.modelo:PivotTo(inicio:Lerp(alvo, t) + Vector3.new(0, altura * 4 * t * (1 - t), 0))
			if t >= 1 then
				break
			end
			RunService.Heartbeat:Wait()
		end
		if aoTerminar then
			aoTerminar()
		end
	end)
end

function Game.destruirRobo(robo)
	if robo.estado == "destruido" then
		return
	end
	if robo.estado == "carregado" and Game.aoDestruirCarregado then
		Game.aoDestruirCarregado(robo)
	end
	local dono = robo.dono
	if dono and robo.vaga and dono.vagas[robo.vaga] == robo then
		dono.vagas[robo.vaga] = nil
	end
	robo.estado = "destruido"
	robo.voo = robo.voo + 1
	robo.dono = nil
	robo.vaga = nil
	robo.modelo:Destroy()
	if dono then
		Game.atualizarBase(dono)
		Game.atualizarAtributos(dono)
	end
end

-- Vagas e bases ---------------------------------------------------------------

function Game.vagasTotais(estado)
	return Config.vagasTotais(estado.melhorias.vagas, estado.passes.vagas)
end

function Game.vagasOcupadas(estado)
	local n = 0
	for _ in pairs(estado.vagas) do
		n = n + 1
	end
	return n
end

function Game.vagaLivre(estado)
	for vaga = 1, Game.vagasTotais(estado) do
		if estado.vagas[vaga] == nil then
			return vaga
		end
	end
	return nil
end

-- Atualiza o visual da base: cor e enfeites pelo nível, pedestais e anéis.
function Game.atualizarBase(estado)
	local base = estado.base
	if base.dono ~= estado then
		return
	end
	MapBuilder.aplicarNivel(base, estado.melhorias.renda, true)
	local cores = {}
	for vaga, robo in pairs(estado.vagas) do
		cores[vaga] = Config.Raridades[robo.def.raridade].cor
	end
	MapBuilder.atualizarVagas(base, Game.vagasTotais(estado), cores)
end

-- Põe o robô na vaga do jogador. instantaneo = sem animação (ao carregar).
function Game.colocarNaBase(estado, robo, vaga, instantaneo)
	estado.vagas[vaga] = robo
	robo.dono = estado
	robo.vaga = vaga
	robo.ladrao = nil
	local novo = not estado.descobertos[robo.def.id]
	estado.descobertos[robo.def.id] = true

	local prompt = robo.prompt
	prompt.Enabled = false
	prompt.ActionText = "Steal"
	prompt.HoldDuration = Config.ROUBO.SEGURAR
	prompt.ObjectText = Config.nomeCompleto(robo.def, robo.mut, "en")
	prompt:SetAttribute("DonoId", estado.player.UserId)
	prompt:SetAttribute("Venda", Game.valorVenda(robo))
	robo.modelo:SetAttribute("DonoId", estado.player.UserId)

	local alvo = estado.base.pedestais[vaga]
	local function chegou()
		if robo.dono == estado and estado.vagas[vaga] == robo and robo.estado == "voando" then
			robo.estado = "base"
			prompt.Enabled = true
			Game.atualizarAtributos(estado)
			if not instantaneo then
				Game.efeito("pouso", alvo.Position, Config.Raridades[robo.def.raridade].cor)
			end
		end
	end

	robo.estado = "voando"
	if instantaneo then
		robo.voo = robo.voo + 1
		robo.modelo:PivotTo(alvo)
		chegou()
	else
		Game.voar(robo, alvo, chegou)
	end
	Game.atualizarBase(estado)
	Game.atualizarAtributos(estado)
	if novo and Game.aoDescobrir then
		Game.aoDescobrir(estado, robo.def)
	end
end

-- Tira o robô da vaga do dono atual (sem destruir).
function Game.tirarDaBase(robo)
	local dono = robo.dono
	if dono and robo.vaga and dono.vagas[robo.vaga] == robo then
		dono.vagas[robo.vaga] = nil
	end
	robo.dono = nil
	robo.vaga = nil
	if dono then
		Game.atualizarBase(dono)
		Game.atualizarAtributos(dono)
	end
end

-- Dá um robô de presente (prêmio, caixa, VIP, grupo). Se a base estiver
-- cheia, vira dinheiro (o valor cheio do robô).
function Game.darRobo(estado, def, mut)
	local vaga = Game.vagaLivre(estado)
	if not vaga then
		local valor = Config.precoDe(def, mut)
		Game.adicionarDinheiro(estado, valor)
		Game.notificar(estado.player, "info", "premio_robo_cheio", Game.nomeRobo(def, mut), Game.dinheiroTexto(valor))
		return false
	end
	local origem = estado.base.nascer * CFrame.new(0, 12, 0)
	local robo = Game.novoRobo(def, mut, origem)
	Game.colocarNaBase(estado, robo, vaga, false)
	return true
end

function Game.pegarBaseLivre()
	for _, base in ipairs(Game.mundo.bases) do
		if base.dono == nil then
			return base
		end
	end
	return nil
end

-- Dinheiro e bônus ------------------------------------------------------------

function Game.raridadesCompletas(estado)
	local n = 0
	for _ in pairs(estado.indicePremios) do
		n = n + 1
	end
	return n
end

function Game.multiplicador(estado)
	local m = Config.multiplicadorRenascer(estado.renascimentos)
	m = m * (1 + Config.MELHORIAS.renda.bonus * estado.melhorias.renda)
	if estado.passes.dobro then
		m = m * 2
	end
	if estado.passes.vip then
		m = m * (1 + Config.LOJA.VIP_BONUS)
	end
	m = m * (1 + Config.BONUS.POR_AMIGO * math.min(estado.amigos, Config.BONUS.MAX_AMIGOS))
	if estado.noGrupo then
		m = m * (1 + Config.GRUPO.BONUS)
	end
	if estado.premium then
		m = m * (1 + Config.BONUS.PREMIUM)
	end
	m = m * (1 + Config.BONUS.POR_RARIDADE_COMPLETA * Game.raridadesCompletas(estado))
	if agora() < estado.dobroAte then
		m = m * 2
	end
	return m
end

-- renda sem o x2 temporário do anúncio (usada no dinheiro offline)
function Game.rendaBase(estado)
	local total = 0
	for _, robo in pairs(estado.vagas) do
		if robo.estado == "base" then
			total = total + Config.rendaDe(robo.def, robo.mut)
		end
	end
	return total
end

function Game.rendaPorSegundo(estado)
	return Game.rendaBase(estado) * Game.multiplicador(estado)
end

local function mostrarDinheiro(estado)
	estado.valorDinheiro.Value = math.min(math.floor(estado.dinheiro), MAIOR_INTEIRO)
end

function Game.adicionarDinheiro(estado, valor)
	if type(valor) ~= "number" or valor ~= valor or valor < 0 then
		return
	end
	estado.dinheiro = estado.dinheiro + valor
	estado.totalGanho = estado.totalGanho + valor
	mostrarDinheiro(estado)
end

function Game.gastar(estado, valor)
	if estado.dinheiro < valor then
		return false
	end
	estado.dinheiro = estado.dinheiro - valor
	mostrarDinheiro(estado)
	return true
end

local ultimoDobro = {}
function Game.pagarRenda()
	for _, estado in pairs(Game.estados) do
		local renda = Game.rendaPorSegundo(estado)
		if renda > 0 then
			Game.adicionarDinheiro(estado, renda)
		end
		-- quando o x2 do anúncio acaba, a tela precisa saber
		local dobroAtivo = agora() < estado.dobroAte
		if ultimoDobro[estado] ~= dobroAtivo then
			ultimoDobro[estado] = dobroAtivo
			Game.atualizarAtributos(estado)
		end
	end
end

-- Atributos que a interface do jogador lê
function Game.atualizarAtributos(estado)
	local player = estado.player
	player:SetAttribute("RendaPorSegundo", Game.rendaPorSegundo(estado))
	player:SetAttribute("Multiplicador", Game.multiplicador(estado))
	player:SetAttribute("CustoRenascer", Config.custoRenascer(estado.renascimentos))
	player:SetAttribute("TrancadaAte", estado.trancadaAte)
	player:SetAttribute("VagasOcupadas", Game.vagasOcupadas(estado))
	player:SetAttribute("VagasTotais", Game.vagasTotais(estado))
	player:SetAttribute("NivelRenda", estado.melhorias.renda)
	player:SetAttribute("NivelVagas", estado.melhorias.vagas)
	player:SetAttribute("NivelTapa", estado.melhorias.tapa)
	player:SetAttribute("PasseDobro", estado.passes.dobro)
	player:SetAttribute("PasseVip", estado.passes.vip)
	player:SetAttribute("PasseVagas", estado.passes.vagas)
	player:SetAttribute("PasseTranca", estado.passes.tranca)
	player:SetAttribute("DobroAte", estado.dobroAte)
	player:SetAttribute("Amigos", math.min(estado.amigos, Config.BONUS.MAX_AMIGOS))

	local lista = {}
	for _, def in ipairs(Config.Robos) do
		if estado.descobertos[def.id] then
			table.insert(lista, def.id)
		end
	end
	player:SetAttribute("Descobertos", table.concat(lista, ","))

	local completas = {}
	for raridade = 1, #Config.Raridades do
		if estado.indicePremios[tostring(raridade)] then
			table.insert(completas, tostring(raridade))
		end
	end
	player:SetAttribute("IndicePremios", table.concat(completas, ","))
end

-- Entrada e saída de jogadores ------------------------------------------------

function Game.adicionarJogador(player, dados, podeSalvar)
	local base = Game.pegarBaseLivre()
	if not base then
		player:Kick(Textos.t(Textos.idiomaDe(player.LocaleId), "servidor_cheio"))
		return nil
	end

	local estado = {
		player = player,
		idioma = Textos.idiomaDe(player.LocaleId),
		base = base,
		vagas = {},
		dinheiro = tonumber(dados.dinheiro) or Config.DINHEIRO_INICIAL,
		renascimentos = tonumber(dados.renascimentos) or 0,
		descobertos = {},
		melhorias = {
			renda = math.clamp(tonumber(dados.melhorias.renda) or 0, 0, Config.MELHORIAS.renda.max),
			vagas = math.clamp(tonumber(dados.melhorias.vagas) or 0, 0, Config.MELHORIAS.vagas.max),
			tapa = math.clamp(tonumber(dados.melhorias.tapa) or 0, 0, Config.MELHORIAS.tapa.max),
		},
		passes = { dobro = false, vip = false, vagas = false, tranca = false },
		amigos = 0,
		noGrupo = false,
		premium = false,
		indicePremios = {},
		dobroAte = tonumber(dados.dobroAte) or 0,
		totalGanho = tonumber(dados.totalGanho) or 0,
		dados = dados, -- campos que o Progresso e a Loja usam
		podeSalvar = podeSalvar,
		carregando = nil,
		trancadaAte = 0,
		noBotao = false,
		ultimoTapa = 0,
		saindo = false,
	}
	base.dono = estado
	Game.estados[player] = estado

	if type(dados.descobertos) == "table" then
		for id, sim in pairs(dados.descobertos) do
			if sim and Config.RoboPorId[id] then
				estado.descobertos[id] = true
			end
		end
	end
	if type(dados.indicePremios) == "table" then
		for raridade, sim in pairs(dados.indicePremios) do
			if sim and Config.Raridades[tonumber(raridade) or 0] then
				estado.indicePremios[tostring(raridade)] = true
			end
		end
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local valorDinheiro = Instance.new("IntValue")
	valorDinheiro.Name = "Dinheiro"
	valorDinheiro.Parent = leaderstats
	local valorRenascimentos = Instance.new("IntValue")
	valorRenascimentos.Name = "Renascimentos"
	valorRenascimentos.Value = estado.renascimentos
	valorRenascimentos.Parent = leaderstats
	leaderstats.Parent = player
	estado.valorDinheiro = valorDinheiro
	estado.valorRenascimentos = valorRenascimentos
	mostrarDinheiro(estado)

	base.modelo:SetAttribute("DonoNome", player.DisplayName)
	base.modelo:SetAttribute("DonoId", player.UserId)
	player:SetAttribute("Base", base.indice)
	return estado
end

-- Devolve os robôs salvos para os pedestais (depois que os passes carregaram,
-- para as vagas extras do passe já contarem).
function Game.restaurarRobos(estado)
	local dados = estado.dados
	if type(dados.robos) ~= "table" then
		return
	end
	local total = Game.vagasTotais(estado)
	for _, salvo in ipairs(dados.robos) do
		local def = type(salvo) == "table" and Config.RoboPorId[salvo.id]
		if def then
			local mut = salvo.mut
			if mut ~= nil and Config.MutacaoPorId[mut] == nil then
				mut = nil
			end
			local vaga = tonumber(salvo.vaga)
			if vaga == nil or vaga < 1 or vaga > total or estado.vagas[vaga] then
				vaga = Game.vagaLivre(estado)
			end
			if vaga then
				local robo = Game.novoRobo(def, mut, estado.base.pedestais[vaga])
				Game.colocarNaBase(estado, robo, vaga, true)
			else
				-- não cabe mais (nunca deveria acontecer): vira dinheiro
				Game.adicionarDinheiro(estado, Config.precoDe(def, mut))
			end
		end
	end
	Game.atualizarBase(estado)
	Game.atualizarAtributos(estado)
end

function Game.serializar(estado)
	local robos = {}
	for vaga = 1, Config.MAX_PEDESTAIS do
		local robo = estado.vagas[vaga]
		if robo then
			table.insert(robos, { id = robo.def.id, mut = robo.mut, vaga = vaga })
		end
	end
	local descobertos = {}
	for id in pairs(estado.descobertos) do
		descobertos[id] = true
	end
	local indice = {}
	for raridade in pairs(estado.indicePremios) do
		indice[raridade] = true
	end
	local dados = estado.dados
	dados.dinheiro = math.floor(estado.dinheiro)
	dados.renascimentos = estado.renascimentos
	dados.robos = robos
	dados.descobertos = descobertos
	dados.indicePremios = indice
	dados.melhorias = {
		renda = estado.melhorias.renda,
		vagas = estado.melhorias.vagas,
		tapa = estado.melhorias.tapa,
	}
	dados.dobroAte = estado.dobroAte
	dados.totalGanho = math.floor(estado.totalGanho)
	dados.saida = math.floor(agora())
	return dados
end

-- Retorna (estado, dadosParaSalvar)
function Game.removerJogador(player)
	local estado = Game.estados[player]
	if not estado then
		return nil, nil
	end
	estado.saindo = true
	local dados = Game.serializar(estado)

	if estado.carregando and Game.aoSairComCarga then
		Game.aoSairComCarga(estado)
	end
	for _, robo in pairs(estado.vagas) do
		Game.destruirRobo(robo)
	end
	estado.vagas = {}

	local base = estado.base
	base.dono = nil
	base.modelo:SetAttribute("DonoNome", "")
	base.modelo:SetAttribute("DonoId", 0)
	base.modelo:SetAttribute("TrancadaAte", 0)
	base.barreira.Transparency = 1
	MapBuilder.aplicarNivel(base, 0, false)
	MapBuilder.atualizarVagas(base, 0, {})
	Game.estados[player] = nil
	ultimoDobro[estado] = nil
	return estado, dados
end

-- Tranca da base --------------------------------------------------------------

function Game.trancada(estado)
	return agora() < estado.trancadaAte
end

function Game.trancar(estado)
	if Game.trancada(estado) then
		return
	end
	local duracao = Config.duracaoTranca(estado.renascimentos, estado.passes.tranca)
	estado.trancadaAte = agora() + duracao
	estado.base.barreira.Transparency = 0.2
	estado.base.modelo:SetAttribute("TrancadaAte", estado.trancadaAte)
	Game.atualizarAtributos(estado)
	Game.notificar(estado.player, "bom", "trancou", duracao)
	Game.emitir(estado, "trancar", 1)
end

local function raizDe(player)
	local personagem = player.Character
	local humanoid = personagem and personagem:FindFirstChildOfClass("Humanoid")
	local raiz = personagem and personagem:FindFirstChild("HumanoidRootPart")
	if raiz and humanoid and humanoid.Health > 0 then
		return raiz, humanoid, personagem
	end
	return nil
end
Game.raizDe = raizDe

-- Roda várias vezes por segundo: botão de trancar e expulsão de intrusos.
-- (A contagem regressiva é desenhada no jogador a partir do atributo.)
function Game.vigiarBases()
	for _, estado in pairs(Game.estados) do
		local base = estado.base
		if Game.trancada(estado) then
			base.barreira.Transparency = 0.2
			for player, outro in pairs(Game.estados) do
				if outro ~= estado then
					local raiz, _, personagem = raizDe(player)
					if raiz and MapBuilder.dentroDaBase(base, raiz.Position, 0) then
						personagem:PivotTo(base.saida)
					end
				end
			end
		elseif base.barreira.Transparency < 1 then
			base.barreira.Transparency = 1
		end

		-- tranca quando o dono PISA no botão (precisa sair e pisar de novo)
		local raiz = raizDe(estado.player)
		local emCima = false
		if raiz then
			local delta = raiz.Position - base.botao.Position
			emCima = math.abs(delta.Y) < 6 and Vector3.new(delta.X, 0, delta.Z).Magnitude < 3.5
		end
		if emCima and not estado.noBotao and not Game.trancada(estado) then
			Game.trancar(estado)
		end
		estado.noBotao = emCima
	end
end

-- Renascimento ----------------------------------------------------------------

function Game.renascer(estado)
	local custo = Config.custoRenascer(estado.renascimentos)
	if estado.dinheiro < custo then
		Game.notificar(estado.player, "ruim", "renascer_falta", Game.dinheiroTexto(custo))
		return false
	end
	if estado.carregando then
		Game.notificar(estado.player, "ruim", "renascer_carregando")
		return false
	end

	for _, robo in pairs(estado.vagas) do
		Game.destruirRobo(robo)
	end
	estado.vagas = {}
	estado.renascimentos = estado.renascimentos + 1
	estado.valorRenascimentos.Value = estado.renascimentos
	estado.dinheiro = Config.DINHEIRO_INICIAL
	mostrarDinheiro(estado)
	Game.atualizarBase(estado)
	Game.atualizarAtributos(estado)

	local mult = Config.multiplicadorRenascer(estado.renascimentos)
	Game.notificarTodos("alerta", "renasceu", estado.player.DisplayName, function(idioma)
		return Format.multiplicador(mult, idioma)
	end)
	local raiz = raizDe(estado.player)
	if raiz then
		Game.efeito("renascer", raiz.Position, Color3.fromRGB(166, 77, 255))
	end
	return true
end

-- Sorteio usado por prêmios
function Game.aleatorio()
	return aleatorio
end

return Game
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX00000000000000000000000000000007"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--[[
	Robot Heist / Rouba Robô — script principal do servidor.
	Monta o mapa, liga os sistemas e cuida da entrada e saída de jogadores.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Textos = require(Shared:WaitForChild("Textos"))

local pasta = script.Parent
local MapBuilder = require(pasta:WaitForChild("MapBuilder"))
local Data = require(pasta:WaitForChild("Data"))
local Game = require(pasta:WaitForChild("Game"))
local Conveyor = require(pasta:WaitForChild("Conveyor"))
local Stealing = require(pasta:WaitForChild("Stealing"))
local Progresso = require(pasta:WaitForChild("Progresso"))
local Shop = require(pasta:WaitForChild("Shop"))
local Ranking = require(pasta:WaitForChild("Ranking"))

-- Canais de comunicação com os jogadores ------------------------------------
local remotos = Instance.new("Folder")
remotos.Name = "Remotos"
local function remoto(nome)
	local evento = Instance.new("RemoteEvent")
	evento.Name = nome
	evento.Parent = remotos
	return evento
end
-- servidor -> jogador
local Notificar = remoto("Notificar")
local Empurrao = remoto("Empurrao")
local Efeito = remoto("Efeito")
-- jogador -> servidor (o servidor sempre confere tudo)
local Renascer = remoto("Renascer")
local Melhorar = remoto("Melhorar")
local PegarDiario = remoto("PegarDiario")
local PegarMissao = remoto("PegarMissao")
local ColetarOffline = remoto("ColetarOffline")
local VerAnuncio = remoto("VerAnuncio")
local Teste = remoto("Teste") -- botões de teste (só funcionam no Studio)
remotos.Parent = ReplicatedStorage

-- Liga os sistemas -----------------------------------------------------------
local mundo = MapBuilder.construir()
Game.iniciar(mundo, {
	Notificar = Notificar,
	Empurrao = Empurrao,
	Efeito = Efeito,
})
Conveyor.iniciar()
Stealing.iniciar()
Progresso.iniciar()
Shop.iniciar()

local function salvar(estado, liberar)
	if estado.podeSalvar then
		Data.salvar(estado.player, Game.serializar(estado), liberar)
		Ranking.registrar(estado.player, estado.totalGanho)
	end
end
Shop.aoComprar = function(estado)
	task.spawn(salvar, estado, false)
end

-- Limite de pedidos por jogador (contra quem dispara remotos sem parar) -----
local ultimosPedidos = {}
local function permitir(player, nome, intervalo)
	local porJogador = ultimosPedidos[player]
	if not porJogador then
		porJogador = {}
		ultimosPedidos[player] = porJogador
	end
	local agora = os.clock()
	if porJogador[nome] and agora - porJogador[nome] < intervalo then
		return false
	end
	porJogador[nome] = agora
	return true
end

-- Etiqueta VIP em cima da cabeça
function Game.etiquetaVip(estado)
	local personagem = estado.player.Character
	local cabeca = personagem and personagem:FindFirstChild("Head")
	if not estado.passes.vip or not cabeca or cabeca:FindFirstChild("EtiquetaVip") then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "EtiquetaVip"
	gui.Size = UDim2.fromOffset(80, 30)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	gui.Adornee = cabeca
	local texto = Instance.new("TextLabel")
	texto.Size = UDim2.fromScale(1, 1)
	texto.BackgroundTransparency = 1
	texto.Font = Enum.Font.LuckiestGuy
	texto.TextScaled = true
	texto.Text = "VIP"
	texto.TextColor3 = Color3.fromRGB(255, 216, 77)
	texto.TextStrokeTransparency = 0
	texto.TextStrokeColor3 = Color3.fromRGB(20, 23, 43)
	texto.Parent = gui
	gui.Parent = cabeca
end

-- Jogadores ------------------------------------------------------------------
local function aoNascer(player, estado, personagem)
	local humanoid = personagem:WaitForChild("Humanoid", 10)
	local raiz = personagem:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not raiz then
		return
	end
	humanoid.WalkSpeed = Config.ROUBO.VELOCIDADE_NORMAL
	task.wait(0.1) -- deixa o Roblox terminar de posicionar o personagem
	if Game.estados[player] == estado and personagem.Parent then
		personagem:PivotTo(estado.base.nascer)
		Stealing.darTapa(player)
		Game.etiquetaVip(estado)
	end
end

local function aoEntrar(player)
	local dados, situacao = Data.carregar(player)
	if player.Parent == nil then
		-- saiu enquanto carregava: solta a trava para não travar o próximo servidor
		if situacao == "ok" then
			Data.salvar(player, dados, true)
		end
		return
	end
	local idioma = Textos.idiomaDe(player.LocaleId)
	if situacao == "falha" or situacao == "ocupado" then
		player:Kick(Textos.t(idioma, situacao == "ocupado" and "dados_ocupados" or "dados_falha"))
		return
	end
	local podeSalvar = situacao == "ok"
	local estado = Game.adicionarJogador(player, dados, podeSalvar)
	if not estado then
		if podeSalvar then
			Data.salvar(player, dados, true)
		end
		return
	end

	Shop.verificarPasses(estado)
	Shop.verificarPolitica(estado)
	if Game.estados[player] ~= estado then
		return -- saiu durante a verificação (já foi salvo ao sair)
	end
	Game.restaurarRobos(estado)
	Shop.aplicarPasses(estado)
	Progresso.aoEntrar(estado)

	player.CharacterAdded:Connect(function(personagem)
		aoNascer(player, estado, personagem)
	end)
	if player.Character then
		task.spawn(aoNascer, player, estado, player.Character)
	end

	Game.notificar(player, "info", "bemvindo")
	Game.notificar(player, "info", "dica_tranca")
	if not podeSalvar then
		Game.notificar(player, "alerta", "nao_salva")
	end
end

Players.PlayerAdded:Connect(aoEntrar)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(aoEntrar, player)
end

Players.PlayerRemoving:Connect(function(player)
	ultimosPedidos[player] = nil
	local estadoAtual = Game.estados[player]
	if estadoAtual then
		Progresso.aoSair(estadoAtual)
	end
	local estado, dados = Game.removerJogador(player)
	if estado then
		task.spawn(Progresso.atualizarAmigos)
		if estado.podeSalvar then
			Data.salvar(player, dados, true)
			Ranking.registrar(player, estado.totalGanho)
		end
	end
end)

game:BindToClose(function()
	local pendentes = 0
	for _, estado in pairs(Game.estados) do
		if estado.podeSalvar then
			pendentes = pendentes + 1
			task.spawn(function()
				Progresso.aoSair(estado)
				salvar(estado, true)
				pendentes = pendentes - 1
			end)
		end
	end
	local limite = os.clock() + (RunService:IsStudio() and 3 or 25)
	while pendentes > 0 and os.clock() < limite do
		task.wait(0.1)
	end
end)

-- Pedidos dos jogadores ------------------------------------------------------
local function estadoDe(player, nome, intervalo)
	if not permitir(player, nome, intervalo) then
		return nil
	end
	return Game.estados[player]
end

Renascer.OnServerEvent:Connect(function(player)
	local estado = estadoDe(player, "Renascer", 1)
	if estado then
		Game.renascer(estado)
	end
end)

Melhorar.OnServerEvent:Connect(function(player, tipo)
	local estado = estadoDe(player, "Melhorar", 0.25)
	if estado and type(tipo) == "string" then
		Progresso.melhorar(estado, tipo)
	end
end)

PegarDiario.OnServerEvent:Connect(function(player)
	local estado = estadoDe(player, "PegarDiario", 1)
	if estado then
		Progresso.pegarDiario(estado)
	end
end)

PegarMissao.OnServerEvent:Connect(function(player, indice)
	local estado = estadoDe(player, "PegarMissao", 0.5)
	if estado and type(indice) == "number" then
		Progresso.pegarMissao(estado, indice)
	end
end)

ColetarOffline.OnServerEvent:Connect(function(player)
	local estado = estadoDe(player, "ColetarOffline", 1)
	if estado then
		Progresso.coletarOffline(estado, false)
	end
end)

VerAnuncio.OnServerEvent:Connect(function(player, motivo)
	local estado = estadoDe(player, "VerAnuncio", 5)
	if estado and type(motivo) == "string" then
		Shop.verAnuncio(estado, motivo)
	end
end)

Teste.OnServerEvent:Connect(function(player, acao)
	if not RunService:IsStudio() then
		return -- os botões de teste só funcionam no Roblox Studio
	end
	local estado = Game.estados[player]
	if not estado then
		return
	end
	if acao == "dinheiro" then
		local valor = math.max(1000000, Game.rendaPorSegundo(estado) * 600)
		Game.adicionarDinheiro(estado, valor)
		Game.notificar(player, "info", "teste_dinheiro", Game.dinheiroTexto(valor))
	elseif acao == "sorte" then
		Conveyor.iniciarSorte(Config.SORTE.DURACAO, nil)
	elseif acao == "dia" then
		-- finge que é outro dia: libera o prêmio diário e novas missões
		estado.dados.diario.ultimoDia = Progresso.diaAtual() - 1
		estado.dados.missoes.dia = -1
		estado.diaMissoes = nil
		estado.offlinePendente = math.floor(math.max(1000, Game.rendaPorSegundo(estado) * 600))
		player:SetAttribute("OfflinePendente", estado.offlinePendente)
		Progresso.atualizarAtributos(estado)
	end
end)

-- Laços do jogo --------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(1)
		Game.pagarRenda()
	end
end)

task.spawn(function()
	while true do
		task.wait(0.2)
		Game.vigiarBases()
		Stealing.vigiar()
	end
end)

task.spawn(function()
	while true do
		task.wait(60)
		Progresso.cadaMinuto()
	end
end)

task.spawn(function()
	task.wait(5)
	while true do
		Ranking.atualizar(mundo.ranking)
		task.wait(120)
	end
end)

task.spawn(function()
	while true do
		task.wait(90)
		for _, estado in pairs(Game.estados) do
			task.spawn(salvar, estado, false)
		end
	end
end)

print("[Robot Heist] Servidor pronto!")
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000008"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	Constrói o mapa inteiro por código: iluminação, chão, calçadas,
	árvores, esteira, fábrica, reciclagem, placar, quadro "como jogar" e
	as 8 bases. Funciona num lugar vazio do Roblox Studio.

	Cada base tem um "quadro" (CFrame) próprio: a origem fica no centro do
	piso e o eixo +Z local aponta para a entrada (virada para a esteira).

	Os textos do mundo saem no idioma de cada jogador: aqui eles recebem
	uma chave (atributo "Chave" + tag "TextoLocal") e o script do jogador
	troca pelo texto certo.
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local MapBuilder = {}

local LARGURA_BASE = 60 -- eixo X local
local PROFUNDIDADE_BASE = 50 -- eixo Z local
local ALTURA_PAREDE = 12
local LARGURA_ENTRADA = 14

MapBuilder.LARGURA_BASE = LARGURA_BASE
MapBuilder.PROFUNDIDADE_BASE = PROFUNDIDADE_BASE

local CONTORNO = Color3.fromRGB(20, 23, 43)
local CINZA_BASE = Color3.fromRGB(185, 194, 211)
local OURO = Color3.fromRGB(255, 200, 61)

local CORES_BASES = {
	Color3.fromRGB(255, 94, 126),
	Color3.fromRGB(61, 165, 255),
	Color3.fromRGB(34, 197, 94),
	Color3.fromRGB(255, 176, 32),
	Color3.fromRGB(166, 77, 255),
	Color3.fromRGB(255, 122, 26),
	Color3.fromRGB(255, 61, 165),
	Color3.fromRGB(20, 184, 166),
}

local function peca(props)
	local classe = props.Classe or "Part"
	local parte = Instance.new(classe)
	parte.Anchored = true
	parte.TopSurface = Enum.SurfaceType.Smooth
	parte.BottomSurface = Enum.SurfaceType.Smooth
	parte.Material = Enum.Material.SmoothPlastic
	for nome, valor in pairs(props) do
		if nome ~= "Parent" and nome ~= "Classe" then
			parte[nome] = valor
		end
	end
	parte.Parent = props.Parent
	return parte
end

-- Texto flutuante. `chave` = texto traduzido pelo jogador (Textos.luau).
local function placa(parte, chave, textoPadrao, cor, largura, altura, deslocamento, distancia, fonte)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Placa"
	gui.Size = UDim2.fromOffset(largura or 300, altura or 60)
	gui.StudsOffset = deslocamento or Vector3.new(0, 0, 0)
	gui.MaxDistance = distancia or 250
	gui.LightInfluence = 0
	gui.Adornee = parte

	local rotulo = Instance.new("TextLabel")
	rotulo.Name = "Texto"
	rotulo.Size = UDim2.fromScale(1, 1)
	rotulo.BackgroundTransparency = 1
	rotulo.Text = textoPadrao or ""
	rotulo.TextColor3 = cor or Color3.new(1, 1, 1)
	rotulo.TextStrokeTransparency = 0
	rotulo.TextStrokeColor3 = CONTORNO
	rotulo.TextScaled = true
	rotulo.Font = fonte or Enum.Font.LuckiestGuy
	rotulo.Parent = gui
	if chave then
		rotulo:SetAttribute("Chave", chave)
		CollectionService:AddTag(rotulo, "TextoLocal")
	end

	gui.Parent = parte
	return rotulo, gui
end

local function arvore(pasta, posicao, tamanho)
	local tronco = peca({
		Name = "Tronco",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(6 * tamanho, 1.6 * tamanho, 1.6 * tamanho),
		CFrame = CFrame.new(posicao + Vector3.new(0, 3 * tamanho, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(140, 90, 55),
		Parent = pasta,
	})
	tronco.CanCollide = true
	peca({
		Name = "Copa",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(8, 8, 8) * tamanho,
		CFrame = CFrame.new(posicao + Vector3.new(0, 8 * tamanho, 0)),
		Color = Color3.fromRGB(70, 190, 80),
		CanCollide = false,
		Parent = pasta,
	})
	peca({
		Name = "Copa",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(5.5, 5.5, 5.5) * tamanho,
		CFrame = CFrame.new(posicao + Vector3.new(1.5 * tamanho, 11 * tamanho, 0.5 * tamanho)),
		Color = Color3.fromRGB(110, 215, 95),
		CanCollide = false,
		Parent = pasta,
	})
end

local function poste(pasta, posicao)
	peca({
		Name = "Poste",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(9, 0.6, 0.6),
		CFrame = CFrame.new(posicao + Vector3.new(0, 4.5, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = CONTORNO,
		Parent = pasta,
	})
	peca({
		Name = "Lampada",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.6, 1.6, 1.6),
		CFrame = CFrame.new(posicao + Vector3.new(0, 9.4, 0)),
		Color = Color3.fromRGB(255, 243, 163),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = pasta,
	})
end

-- Iluminação "cartoon de dia de sol" ------------------------------------------
local function iluminar()
	Lighting.ClockTime = 13.5
	Lighting.Brightness = 2.3
	Lighting.Ambient = Color3.fromRGB(95, 95, 115)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 170)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.ShadowSoftness = 0.3
	Lighting.GlobalShadows = true

	local atmosfera = Instance.new("Atmosphere")
	atmosfera.Density = 0.25
	atmosfera.Offset = 0.1
	atmosfera.Color = Color3.fromRGB(199, 220, 255)
	atmosfera.Decay = Color3.fromRGB(106, 170, 230)
	atmosfera.Glare = 0.2
	atmosfera.Haze = 1
	atmosfera.Parent = Lighting

	local brilho = Instance.new("BloomEffect")
	brilho.Intensity = 0.6
	brilho.Size = 28
	brilho.Threshold = 1.6
	brilho.Parent = Lighting

	local cores = Instance.new("ColorCorrectionEffect")
	cores.Saturation = 0.15
	cores.Contrast = 0.08
	cores.Brightness = 0.02
	cores.Parent = Lighting

	local raios = Instance.new("SunRaysEffect")
	raios.Intensity = 0.06
	raios.Spread = 0.8
	raios.Parent = Lighting
end

-- Base -----------------------------------------------------------------------
local POSICOES_VAGAS = {}
for _, z in ipairs({ -19, -11, -3, 5 }) do
	for _, x in ipairs({ -20, -10, 0, 10, 20 }) do
		table.insert(POSICOES_VAGAS, Vector3.new(x, 0, z))
	end
end

local function construirBase(indice, centro, girada, pasta)
	local cor = CORES_BASES[indice]
	local quadro = CFrame.new(centro)
	if girada then
		quadro = quadro * CFrame.Angles(0, math.pi, 0)
	end

	local modelo = Instance.new("Model")
	modelo.Name = "Base" .. indice
	modelo:SetAttribute("Indice", indice)
	modelo:SetAttribute("DonoNome", "")
	modelo:SetAttribute("Nivel", 0)
	modelo:SetAttribute("TrancadaAte", 0)
	modelo.Parent = pasta

	local function local_(x, y, z)
		return quadro * CFrame.new(x, y, z)
	end

	local meiaLargura = LARGURA_BASE / 2
	local meiaProfundidade = PROFUNDIDADE_BASE / 2
	local yParede = ALTURA_PAREDE / 2

	-- piso
	local piso = peca({
		Name = "Piso",
		Size = Vector3.new(LARGURA_BASE, 0.4, PROFUNDIDADE_BASE),
		CFrame = local_(0, -0.2, 0),
		Color = Color3.fromRGB(255, 236, 242),
		Parent = modelo,
	})

	-- paredes (fundo, laterais e frente com a entrada no meio)
	local paredes = {}
	local function parede(nome, tamanho, x, z)
		local p = peca({
			Name = nome,
			Size = tamanho,
			CFrame = local_(x, yParede, z),
			Color = CINZA_BASE,
			Parent = modelo,
		})
		table.insert(paredes, p)
		return p
	end
	parede("ParedeFundo", Vector3.new(LARGURA_BASE, ALTURA_PAREDE, 2), 0, -meiaProfundidade + 1)
	parede("ParedeEsquerda", Vector3.new(2, ALTURA_PAREDE, PROFUNDIDADE_BASE), -meiaLargura + 1, 0)
	parede("ParedeDireita", Vector3.new(2, ALTURA_PAREDE, PROFUNDIDADE_BASE), meiaLargura - 1, 0)
	local larguraFrente = (LARGURA_BASE - LARGURA_ENTRADA) / 2
	local xFrente = LARGURA_ENTRADA / 2 + larguraFrente / 2
	parede("FrenteEsquerda", Vector3.new(larguraFrente, ALTURA_PAREDE, 2), -xFrente, meiaProfundidade - 1)
	parede("FrenteDireita", Vector3.new(larguraFrente, ALTURA_PAREDE, 2), xFrente, meiaProfundidade - 1)

	-- enfeites que aparecem conforme o nível da base
	local enfeites = { faixa = {}, lampadas = {}, bandeira = {}, pilares = {}, ouro = {}, coroa = {}, feixes = {} }
	local function enfeite(grupo, props)
		props.Parent = modelo
		props.CanCollide = false
		props.Transparency = 1
		local p = peca(props)
		table.insert(enfeites[grupo], p)
		return p
	end

	-- faixa neon no alto das paredes (nível 3)
	enfeite("faixa", { Name = "Faixa", Size = Vector3.new(LARGURA_BASE + 0.2, 1, 2.2), CFrame = local_(0, ALTURA_PAREDE - 1.5, -meiaProfundidade + 1), Material = Enum.Material.Neon, Color = cor })
	enfeite("faixa", { Name = "Faixa", Size = Vector3.new(2.2, 1, PROFUNDIDADE_BASE + 0.2), CFrame = local_(-meiaLargura + 1, ALTURA_PAREDE - 1.5, 0), Material = Enum.Material.Neon, Color = cor })
	enfeite("faixa", { Name = "Faixa", Size = Vector3.new(2.2, 1, PROFUNDIDADE_BASE + 0.2), CFrame = local_(meiaLargura - 1, ALTURA_PAREDE - 1.5, 0), Material = Enum.Material.Neon, Color = cor })

	-- lâmpadas nos cantos e bandeira (nível 5)
	for _, canto in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		enfeite("lampadas", {
			Name = "Lampada",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.4, 2.4, 2.4),
			CFrame = local_(canto[1] * (meiaLargura - 1), ALTURA_PAREDE + 1.2, canto[2] * (meiaProfundidade - 1)),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 243, 163),
		})
	end
	enfeite("bandeira", { Name = "Mastro", Size = Vector3.new(0.5, 10, 0.5), CFrame = local_(-meiaLargura + 4, ALTURA_PAREDE + 5, -meiaProfundidade + 1), Color = CONTORNO })
	enfeite("bandeira", { Name = "Bandeira", Size = Vector3.new(5, 3, 0.3), CFrame = local_(-meiaLargura + 6.7, ALTURA_PAREDE + 8.3, -meiaProfundidade + 1), Color = cor })

	-- pilares neon na entrada (nível 8)
	for _, lado in ipairs({ -1, 1 }) do
		enfeite("pilares", {
			Name = "Pilar",
			Size = Vector3.new(1.4, ALTURA_PAREDE + 4, 1.4),
			CFrame = local_(lado * (LARGURA_ENTRADA / 2 + 0.7), (ALTURA_PAREDE + 4) / 2, meiaProfundidade - 0.2),
			Material = Enum.Material.Neon,
			Color = cor,
		})
	end

	-- acabamento dourado, coroa e holofotes (nível 10)
	enfeite("ouro", { Name = "Ouro", Size = Vector3.new(LARGURA_BASE + 0.6, 0.8, 2.6), CFrame = local_(0, ALTURA_PAREDE + 0.4, -meiaProfundidade + 1), Material = Enum.Material.Metal, Color = OURO, Reflectance = 0.2 })
	enfeite("ouro", { Name = "Ouro", Size = Vector3.new(2.6, 0.8, PROFUNDIDADE_BASE + 0.6), CFrame = local_(-meiaLargura + 1, ALTURA_PAREDE + 0.4, 0), Material = Enum.Material.Metal, Color = OURO, Reflectance = 0.2 })
	enfeite("ouro", { Name = "Ouro", Size = Vector3.new(2.6, 0.8, PROFUNDIDADE_BASE + 0.6), CFrame = local_(meiaLargura - 1, ALTURA_PAREDE + 0.4, 0), Material = Enum.Material.Metal, Color = OURO, Reflectance = 0.2 })
	for i, x in ipairs({ -2.2, 0, 2.2 }) do
		enfeite("coroa", {
			Name = "Coroa",
			Classe = "WedgePart",
			Size = Vector3.new(0.6, i == 2 and 3 or 2.2, 1.6),
			CFrame = local_(x, ALTURA_PAREDE + 9.5, -meiaProfundidade + 1),
			Material = Enum.Material.Metal,
			Color = OURO,
		})
	end
	for _, lado in ipairs({ -1, 1 }) do
		local foco = enfeite("feixes", {
			Name = "Holofote",
			Size = Vector3.new(1.5, 1.5, 1.5),
			CFrame = local_(lado * (meiaLargura - 6), ALTURA_PAREDE + 1, -meiaProfundidade + 1),
			Material = Enum.Material.Neon,
			Color = OURO,
		})
		local a0 = Instance.new("Attachment")
		a0.Parent = foco
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(lado * 12, 70, -10)
		a1.Parent = foco
		local feixe = Instance.new("Beam")
		feixe.Attachment0 = a0
		feixe.Attachment1 = a1
		feixe.Width0 = 2
		feixe.Width1 = 8
		feixe.Color = ColorSequence.new(Color3.fromRGB(255, 243, 163))
		feixe.Transparency = NumberSequence.new(0.6, 1)
		feixe.LightEmission = 1
		feixe.FaceCamera = true
		feixe.Enabled = false
		feixe.Parent = foco
	end

	-- pedestais: 4 fileiras de 5 (as primeiras vagas ficam no fundo)
	local pedestais = {}
	local vagas = {}
	for numero, posicao in ipairs(POSICOES_VAGAS) do
		local bloco = peca({
			Name = "Pedestal" .. numero,
			Size = Vector3.new(6, 1, 6),
			CFrame = local_(posicao.X, 0.5, posicao.Z),
			Color = Color3.fromRGB(59, 63, 92),
			Material = Enum.Material.DiamondPlate,
			Parent = modelo,
		})
		local anel = peca({
			Name = "Anel" .. numero,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.25, 6.6, 6.6),
			CFrame = local_(posicao.X, 1.02, posicao.Z) * CFrame.Angles(0, 0, math.pi / 2),
			Color = Color3.fromRGB(90, 95, 120),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = modelo,
		})
		-- o robô fica em cima do pedestal, olhando para a entrada
		pedestais[numero] = local_(posicao.X, 1, posicao.Z) * CFrame.Angles(0, math.pi, 0)
		vagas[numero] = { bloco = bloco, anel = anel }
	end

	-- botão de trancar (o dono pisa nele)
	local botao = peca({
		Name = "BotaoTrancar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 6, 6),
		CFrame = local_(-21, 0.2, 16) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Color3.fromRGB(255, 59, 59),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = modelo,
	})
	local rotuloBotao = placa(botao, "trancar_base", "LOCK BASE", Color3.new(1, 1, 1), 200, 40, Vector3.new(0, 3, 0), 60)

	-- barreira de laser na entrada (só aparece quando trancada)
	local barreira = peca({
		Name = "Barreira",
		Size = Vector3.new(LARGURA_ENTRADA, ALTURA_PAREDE, 1),
		CFrame = local_(0, yParede, meiaProfundidade - 1),
		Color = Color3.fromRGB(255, 40, 40),
		Material = Enum.Material.ForceField,
		Transparency = 1,
		CanCollide = false,
		Parent = modelo,
	})
	local rotuloTranca = placa(barreira, nil, "", Color3.fromRGB(255, 120, 120), 260, 50, Vector3.new(0, ALTURA_PAREDE / 2 + 3, 0), 150)

	-- placa com o nome do dono e o nível
	local suportePlaca = peca({
		Name = "SuportePlaca",
		Size = Vector3.new(1, 1, 1),
		CFrame = local_(0, ALTURA_PAREDE + 5, -meiaProfundidade + 1),
		Transparency = 1,
		CanCollide = false,
		Parent = modelo,
	})
	local gui = Instance.new("BillboardGui")
	gui.Name = "Placa"
	gui.Size = UDim2.fromOffset(380, 96)
	gui.MaxDistance = 300
	gui.LightInfluence = 0
	gui.Adornee = suportePlaca
	local lista = Instance.new("UIListLayout")
	lista.SortOrder = Enum.SortOrder.LayoutOrder
	lista.HorizontalAlignment = Enum.HorizontalAlignment.Center
	lista.Parent = gui
	local rotuloDono = Instance.new("TextLabel")
	rotuloDono.Name = "Titulo"
	rotuloDono.LayoutOrder = 1
	rotuloDono.Size = UDim2.new(1, 0, 0.65, 0)
	rotuloDono.BackgroundTransparency = 1
	rotuloDono.Font = Enum.Font.LuckiestGuy
	rotuloDono.TextScaled = true
	rotuloDono.TextColor3 = Color3.new(1, 1, 1)
	rotuloDono.TextStrokeTransparency = 0
	rotuloDono.TextStrokeColor3 = CONTORNO
	rotuloDono.Text = "FREE BASE"
	rotuloDono.Parent = gui
	local rotuloNivel = Instance.new("TextLabel")
	rotuloNivel.Name = "Nivel"
	rotuloNivel.LayoutOrder = 2
	rotuloNivel.Size = UDim2.new(1, 0, 0.35, 0)
	rotuloNivel.BackgroundTransparency = 1
	rotuloNivel.Font = Enum.Font.FredokaOne
	rotuloNivel.TextScaled = true
	rotuloNivel.TextColor3 = Color3.fromRGB(255, 216, 77)
	rotuloNivel.TextStrokeTransparency = 0
	rotuloNivel.TextStrokeColor3 = CONTORNO
	rotuloNivel.Text = ""
	rotuloNivel.Parent = gui
	gui.Parent = suportePlaca

	local base = {
		indice = indice,
		quadro = quadro,
		cor = cor,
		modelo = modelo,
		piso = piso,
		paredes = paredes,
		enfeites = enfeites,
		pedestais = pedestais,
		vagas = vagas,
		botao = botao,
		rotuloBotao = rotuloBotao,
		barreira = barreira,
		rotuloTranca = rotuloTranca,
		rotuloDono = rotuloDono,
		rotuloNivel = rotuloNivel,
		nascer = local_(0, 3, 15),
		saida = local_(0, 3, meiaProfundidade + 8),
	}
	MapBuilder.aplicarNivel(base, 0, false)
	MapBuilder.atualizarVagas(base, 0, {})
	return base
end

-- Mostra os enfeites da base de acordo com o nível de renda (0 a 10).
function MapBuilder.aplicarNivel(base, nivel, ocupada)
	local t = 0
	if ocupada then
		t = 0.25 + 0.75 * math.min(1, nivel / 5)
	end
	local corParede = CINZA_BASE:Lerp(base.cor, t)
	for _, p in ipairs(base.paredes) do
		p.Color = corParede
	end
	local function mostrar(grupo, visivel)
		for _, p in ipairs(base.enfeites[grupo]) do
			p.Transparency = visivel and 0 or 1
			for _, item in ipairs(p:GetChildren()) do
				if item:IsA("Beam") then
					item.Enabled = visivel
				end
			end
		end
	end
	mostrar("faixa", ocupada and nivel >= 3)
	mostrar("lampadas", ocupada and nivel >= 5)
	mostrar("bandeira", ocupada and nivel >= 5)
	mostrar("pilares", ocupada and nivel >= 8)
	mostrar("ouro", ocupada and nivel >= 10)
	mostrar("coroa", ocupada and nivel >= 10)
	mostrar("feixes", ocupada and nivel >= 10)
	base.modelo:SetAttribute("Nivel", ocupada and nivel or 0)
end

-- Pedestais liberados aparecem; o anel acende com a cor da raridade.
-- coresOcupadas[vaga] = Color3 da raridade do robô naquela vaga
function MapBuilder.atualizarVagas(base, totalLiberadas, coresOcupadas)
	for numero, vaga in ipairs(base.vagas) do
		local liberada = numero <= totalLiberadas
		vaga.bloco.Transparency = liberada and 0 or 0.75
		local cor = coresOcupadas[numero]
		if liberada and cor then
			vaga.anel.Transparency = 0
			vaga.anel.Color = cor
		elseif liberada then
			vaga.anel.Transparency = 0.4
			vaga.anel.Color = Color3.fromRGB(110, 115, 140)
		else
			vaga.anel.Transparency = 1
		end
	end
end

-- Quadro com SurfaceGui de frente para a esteira
local function quadroDeAviso(pasta, nome, cframe, chaveTitulo, corTitulo, linhas)
	local quadro = peca({
		Name = nome,
		Size = Vector3.new(18, 14, 1),
		CFrame = cframe,
		Color = CONTORNO,
		Parent = pasta,
	})
	for _, x in ipairs({ -7, 7 }) do
		peca({
			Name = "Perna",
			Size = Vector3.new(1, 3, 1),
			CFrame = cframe * CFrame.new(x, -8.5, 0),
			Color = CONTORNO,
			Parent = pasta,
		})
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Tela"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Adornee = quadro
	local lista = Instance.new("UIListLayout")
	lista.SortOrder = Enum.SortOrder.LayoutOrder
	lista.HorizontalAlignment = Enum.HorizontalAlignment.Center
	lista.Padding = UDim.new(0, 6)
	lista.Parent = gui
	local margem = Instance.new("UIPadding")
	margem.PaddingTop = UDim.new(0, 18)
	margem.PaddingLeft = UDim.new(0, 18)
	margem.PaddingRight = UDim.new(0, 18)
	margem.Parent = gui
	local titulo = Instance.new("TextLabel")
	titulo.Name = "Titulo"
	titulo.LayoutOrder = 0
	titulo.Size = UDim2.new(1, 0, 0, 56)
	titulo.BackgroundTransparency = 1
	titulo.Font = Enum.Font.LuckiestGuy
	titulo.TextScaled = true
	titulo.TextColor3 = corTitulo
	titulo.Text = ""
	titulo:SetAttribute("Chave", chaveTitulo)
	CollectionService:AddTag(titulo, "TextoLocal")
	titulo.Parent = gui
	local rotulos = {}
	for i = 1, linhas do
		local linha = Instance.new("TextLabel")
		linha.Name = "Linha" .. i
		linha.LayoutOrder = i
		linha.Size = UDim2.new(1, 0, 0, 30)
		linha.BackgroundTransparency = 1
		linha.Font = Enum.Font.FredokaOne
		linha.TextScaled = true
		linha.TextXAlignment = Enum.TextXAlignment.Left
		linha.TextColor3 = Color3.new(1, 1, 1)
		linha.Text = ""
		linha.Parent = gui
		rotulos[i] = linha
	end
	gui.Parent = quadro
	return quadro, rotulos
end

function MapBuilder.construir()
	iluminar()

	local mapa = Instance.new("Folder")
	mapa.Name = "Mapa"
	mapa.Parent = workspace

	-- chão e calçadas
	peca({
		Name = "Chao",
		Size = Vector3.new(420, 1, 330),
		CFrame = CFrame.new(0, -0.5, 0),
		Color = Color3.fromRGB(106, 200, 90),
		Material = Enum.Material.Grass,
		Parent = mapa,
	})
	for _, z in ipairs({ -21, 21 }) do
		peca({
			Name = "Calcada",
			Size = Vector3.new(330, 0.2, 26),
			CFrame = CFrame.new(0, 0.1, z),
			Color = Color3.fromRGB(255, 236, 196),
			Parent = mapa,
		})
	end

	-- bordas invisíveis para ninguém cair do mapa
	local bordas = {
		{ Vector3.new(420, 60, 2), Vector3.new(0, 30, -166) },
		{ Vector3.new(420, 60, 2), Vector3.new(0, 30, 166) },
		{ Vector3.new(2, 60, 330), Vector3.new(-211, 30, 0) },
		{ Vector3.new(2, 60, 330), Vector3.new(211, 30, 0) },
	}
	for i, borda in ipairs(bordas) do
		peca({
			Name = "Borda" .. i,
			Size = borda[1],
			CFrame = CFrame.new(borda[2]),
			Transparency = 1,
			Parent = mapa,
		})
	end

	-- árvores atrás das bases
	local decoracao = Instance.new("Folder")
	decoracao.Name = "Decoracao"
	decoracao.Parent = mapa
	local sorteio = Random.new(7)
	for _, z in ipairs({ -105, -140, 105, 140 }) do
		for x = -175, 175, 50 do
			local deslocamento = Vector3.new(sorteio:NextNumber(-8, 8), 0, sorteio:NextNumber(-6, 6))
			arvore(decoracao, Vector3.new(x, 0, z) + deslocamento, sorteio:NextNumber(0.9, 1.4))
		end
	end
	for _, x in ipairs({ -195, 195 }) do
		for z = -60, 60, 40 do
			arvore(decoracao, Vector3.new(x, 0, z), sorteio:NextNumber(1, 1.3))
		end
	end
	for x = -120, 120, 40 do
		poste(decoracao, Vector3.new(x, 0, 9))
		poste(decoracao, Vector3.new(x, 0, -9))
	end

	-- esteira (de verdade: quem sobe nela é levado junto)
	local yEsteira = 1
	local esteira = peca({
		Name = "Esteira",
		Size = Vector3.new(330, 1, 10),
		CFrame = CFrame.new(0, 0.5, 0),
		Color = Color3.fromRGB(52, 54, 74),
		Material = Enum.Material.DiamondPlate,
		Parent = mapa,
	})
	esteira.AssemblyLinearVelocity = Vector3.new(Config.ESTEIRA.VELOCIDADE, 0, 0)
	for _, z in ipairs({ -5.4, 5.4 }) do
		peca({
			Name = "Trilho",
			Size = Vector3.new(330, 1.4, 0.8),
			CFrame = CFrame.new(0, 0.7, z),
			Color = Color3.fromRGB(255, 210, 63),
			Material = Enum.Material.Neon,
			Parent = mapa,
		})
	end
	for x = -140, 140, 14 do
		for _, lado in ipairs({ -1, 1 }) do
			peca({
				Name = "Seta",
				Size = Vector3.new(2.6, 0.06, 0.5),
				CFrame = CFrame.new(x, 1.03, lado * 1.1) * CFrame.Angles(0, lado * 0.6, 0),
				Color = Color3.fromRGB(255, 140, 0),
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = mapa,
			})
		end
	end

	-- fábrica (de onde saem os robôs)
	local fabrica = peca({
		Name = "Fabrica",
		Size = Vector3.new(30, 24, 30),
		CFrame = CFrame.new(-165, 12, 0),
		Color = Color3.fromRGB(108, 122, 153),
		Material = Enum.Material.Metal,
		Parent = mapa,
	})
	peca({ Name = "FaixaFabrica", Size = Vector3.new(30.4, 1.6, 30.4), CFrame = CFrame.new(-165, 21, 0), Color = Color3.fromRGB(255, 61, 165), Material = Enum.Material.Neon, Parent = mapa })
	peca({ Name = "Telhado", Size = Vector3.new(22, 6, 22), CFrame = CFrame.new(-167, 27, 0), Color = Color3.fromRGB(255, 210, 63), Parent = mapa })
	peca({ Name = "Portao", Size = Vector3.new(1, 9, 13), CFrame = CFrame.new(-149.6, 4.5, 0), Color = Color3.fromRGB(30, 30, 42), Parent = mapa })
	for _, z in ipairs({ -9, 9 }) do
		peca({
			Name = "Engrenagem",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.8, 7, 7),
			CFrame = CFrame.new(-149.6, 15, z),
			Color = z < 0 and Color3.fromRGB(255, 176, 32) or Color3.fromRGB(61, 165, 255),
			Parent = mapa,
		})
	end
	for _, z in ipairs({ -7, 7 }) do
		local chamine = peca({
			Name = "Chamine",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(14, 5, 5),
			CFrame = CFrame.new(-174, 31, z) * CFrame.Angles(0, 0, math.pi / 2),
			Color = Color3.fromRGB(85, 96, 122),
			Material = Enum.Material.Metal,
			Parent = mapa,
		})
		local fumaca = Instance.new("Smoke")
		fumaca.Color = Color3.fromRGB(230, 235, 245)
		fumaca.Opacity = 0.12
		fumaca.RiseVelocity = 6
		fumaca.Size = 5
		fumaca.Parent = chamine
	end
	placa(fabrica, "fabrica", "ROBOT FACTORY", Color3.fromRGB(255, 216, 77), 460, 80, Vector3.new(0, 19, 0), 450)

	-- reciclagem (onde somem os robôs que ninguém comprou)
	local reciclagem = peca({
		Name = "Reciclagem",
		Size = Vector3.new(22, 16, 22),
		CFrame = CFrame.new(163, 8, 0),
		Color = Color3.fromRGB(40, 70, 55),
		Material = Enum.Material.Metal,
		Parent = mapa,
	})
	peca({ Name = "FaixaReciclagem", Size = Vector3.new(22.4, 1.2, 22.4), CFrame = CFrame.new(163, 13, 0), Color = Color3.fromRGB(75, 240, 138), Material = Enum.Material.Neon, Parent = mapa })
	peca({ Name = "Boca", Size = Vector3.new(1, 7, 12), CFrame = CFrame.new(151.6, 3.5, 0), Color = Color3.fromRGB(20, 30, 25), Parent = mapa })
	placa(reciclagem, "reciclagem", "RECYCLER", Color3.fromRGB(120, 255, 140), 340, 60, Vector3.new(0, 11, 0), 450)

	-- ponto de nascimento neutro (todo mundo é levado para a própria base)
	local nascer = Instance.new("SpawnLocation")
	nascer.Name = "Nascer"
	nascer.Anchored = true
	nascer.Size = Vector3.new(8, 0.4, 8)
	nascer.CFrame = CFrame.new(0, 0.2, 21)
	nascer.Neutral = true
	nascer.Duration = 0
	nascer.Transparency = 0.6
	nascer.CanCollide = false
	nascer.Parent = mapa

	-- placar dos mais ricos (lado sul) e "como jogar" (lado norte)
	local ranking, linhasRanking = quadroDeAviso(mapa, "Ranking", CFrame.new(0, 10, 46),
		"ranking_titulo", Color3.fromRGB(255, 216, 77), 10)
	local _, linhasComo = quadroDeAviso(mapa, "ComoJogar", CFrame.new(0, 10, -46) * CFrame.Angles(0, math.pi, 0),
		"como_jogar", Color3.fromRGB(75, 240, 138), 4)
	for i, linha in ipairs(linhasComo) do
		linha.Size = UDim2.new(1, 0, 0, 52)
		linha:SetAttribute("Chave", "passo" .. i)
		CollectionService:AddTag(linha, "TextoLocal")
	end

	-- bases: 4 ao norte (entrada para +Z) e 4 ao sul (giradas)
	local pastaBases = Instance.new("Folder")
	pastaBases.Name = "Bases"
	pastaBases.Parent = mapa

	local bases = {}
	local xs = { -114, -38, 38, 114 }
	for i, x in ipairs(xs) do
		bases[i] = construirBase(i, Vector3.new(x, 0.2, -62), false, pastaBases)
	end
	for i, x in ipairs(xs) do
		bases[4 + i] = construirBase(4 + i, Vector3.new(x, 0.2, 62), true, pastaBases)
	end

	local pastaRobos = Instance.new("Folder")
	pastaRobos.Name = "Robos"
	pastaRobos.Parent = workspace

	return {
		bases = bases,
		pastaRobos = pastaRobos,
		ranking = ranking,
		linhasRanking = linhasRanking,
		esteira = {
			inicioX = -158,
			fimX = 154,
			y = yEsteira,
			z = 0,
		},
	}
end

-- Converte uma posição do mundo para o espaço da base e diz se está dentro.
-- `folga` aumenta (ou diminui, se negativa) a área considerada.
function MapBuilder.dentroDaBase(base, posicao, folga)
	folga = folga or 0
	local relativo = base.quadro:PointToObjectSpace(posicao)
	return math.abs(relativo.X) <= LARGURA_BASE / 2 + folga
		and math.abs(relativo.Z) <= PROFUNDIDADE_BASE / 2 + folga
		and relativo.Y > -5
		and relativo.Y < 40
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000009"><Properties><string name="Name">Progresso</string><ProtectedString name="Source"><![CDATA[--[[
	Tudo que faz o jogador voltar: prêmio diário, missões do dia, dinheiro
	ganho com o jogo fechado, melhorias da base, prêmios do Índice e os
	bônus de amigos, grupo e Roblox Premium.

	Os dias seguem o relógio do Roblox (UTC), igual para o mundo todo:
	um "dia" novo começa à 0h UTC, que é 21h no horário de Brasília.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Textos = require(Shared:WaitForChild("Textos"))
local Game = require(script.Parent:WaitForChild("Game"))
local Conveyor = require(script.Parent:WaitForChild("Conveyor"))

local Progresso = {}

local DIA = 86400

local function diaAtual()
	return math.floor(Game.agora() / DIA)
end
Progresso.diaAtual = diaAtual

-- Prêmios ----------------------------------------------------------------------
-- Entrega um prêmio e devolve a descrição (para o aviso).
function Progresso.darPremio(estado, premio)
	if premio.tipo == "dinheiro" then
		local valor = Config.dinheiroDe(premio, Game.rendaPorSegundo(estado))
		Game.adicionarDinheiro(estado, valor)
		return Game.dinheiroTexto(valor)
	elseif premio.tipo == "robo" then
		local def = Config.sortearDaRaridade(premio.raridade, Game.aleatorio())
		Game.darRobo(estado, def, nil)
		return Game.nomeRobo(def, nil)
	elseif premio.tipo == "sorte" then
		Conveyor.iniciarSorte(premio.minutos * 60, estado.player.DisplayName)
		return function(idioma)
			return Textos.t(idioma, "premio_sorte", premio.minutos)
		end
	end
	return ""
end

-- Prêmio diário ----------------------------------------------------------------
-- Retorna (dia 1..7 que aparece, pode pegar agora?)
function Progresso.situacaoDiario(estado)
	local d = estado.dados.diario
	local hoje = diaAtual()
	local sequencia = tonumber(d.sequencia) or 0
	local ultimo = tonumber(d.ultimoDia) or -1
	if ultimo == hoje then
		return ((sequencia - 1) % #Config.PREMIO_DIARIO) + 1, false
	end
	if ultimo ~= hoje - 1 then
		sequencia = 0
	end
	return (sequencia % #Config.PREMIO_DIARIO) + 1, true
end

function Progresso.pegarDiario(estado)
	local dia, pronto = Progresso.situacaoDiario(estado)
	if not pronto then
		Game.notificar(estado.player, "info", "diario_ja")
		return false
	end
	local d = estado.dados.diario
	local hoje = diaAtual()
	local sequencia = (tonumber(d.ultimoDia) == hoje - 1) and (tonumber(d.sequencia) or 0) or 0
	d.sequencia = sequencia + 1
	d.ultimoDia = hoje
	local descricao = Progresso.darPremio(estado, Config.PREMIO_DIARIO[dia])
	Game.notificar(estado.player, "bom", "diario_ok", dia, descricao)
	Game.remotos.Efeito:FireClient(estado.player, "premio")
	Progresso.atualizarAtributos(estado)
	Game.atualizarAtributos(estado)
	return true
end

-- Missões ----------------------------------------------------------------------
local function garantirMissoes(estado)
	local m = estado.dados.missoes
	local hoje = diaAtual()
	if m.dia ~= hoje then
		m.dia = hoje
		m.progresso = {}
		m.pegas = {}
	end
	if estado.diaMissoes ~= hoje then
		estado.diaMissoes = hoje
		estado.missoesDoDia = Config.missoesDoDia(hoje, estado.player.UserId)
	end
end

function Progresso.contar(estado, tipo, quantidade, info)
	if not estado.dados then
		return
	end
	garantirMissoes(estado)
	local m = estado.dados.missoes
	local mudou = false
	for _, missao in ipairs(estado.missoesDoDia) do
		local conta = missao.tipo == tipo
		if missao.tipo == "comprarRaridade" then
			conta = tipo == "comprar" and info ~= nil and (info.raridade or 0) >= missao.raridade
		end
		if conta and not m.pegas[missao.id] then
			local atual = tonumber(m.progresso[missao.id]) or 0
			if atual < missao.meta then
				m.progresso[missao.id] = math.min(missao.meta, atual + quantidade)
				mudou = true
			end
		end
	end
	if mudou then
		Progresso.atualizarAtributos(estado)
	end
end

function Progresso.pegarMissao(estado, indice)
	if type(indice) ~= "number" or indice ~= indice or indice % 1 ~= 0 then
		return false
	end
	garantirMissoes(estado)
	local missao = estado.missoesDoDia[indice]
	if not missao then
		return false
	end
	local m = estado.dados.missoes
	if m.pegas[missao.id] or (tonumber(m.progresso[missao.id]) or 0) < missao.meta then
		return false
	end
	m.pegas[missao.id] = true
	local descricao = Progresso.darPremio(estado, missao.premio)
	Game.notificar(estado.player, "bom", "missao_ok", descricao)
	Game.remotos.Efeito:FireClient(estado.player, "premio")
	Progresso.atualizarAtributos(estado)
	Game.atualizarAtributos(estado)
	return true
end

-- Dinheiro com o jogo fechado ------------------------------------------------
function Progresso.calcularOffline(estado)
	local saida = tonumber(estado.dados.saida) or 0
	if saida <= 0 then
		return 0
	end
	local segundos = math.min(Game.agora() - saida, Config.OFFLINE.MAX_HORAS * 3600)
	if segundos < Config.OFFLINE.MINIMO_SEGUNDOS then
		return 0
	end
	local multiplicador = Game.multiplicador(estado)
	if Game.agora() < estado.dobroAte then
		multiplicador = multiplicador / 2 -- o x2 do anúncio não vale para o tempo fora
	end
	return math.floor(Game.rendaBase(estado) * multiplicador * segundos * Config.OFFLINE.EFICIENCIA)
end

function Progresso.coletarOffline(estado, dobrado)
	local valor = estado.offlinePendente or 0
	if valor <= 0 then
		return false
	end
	estado.offlinePendente = 0
	if dobrado then
		valor = valor * 2
	end
	Game.adicionarDinheiro(estado, valor)
	estado.player:SetAttribute("OfflinePendente", 0)
	Game.notificar(estado.player, "bom", "offline_ok", Game.dinheiroTexto(valor))
	Game.remotos.Efeito:FireClient(estado.player, "premio")
	return true
end

-- Melhorias da base ------------------------------------------------------------
function Progresso.melhorar(estado, tipo)
	if tipo ~= "renda" and tipo ~= "vagas" and tipo ~= "tapa" then
		return false
	end
	local nivel = estado.melhorias[tipo]
	local custo = Config.custoMelhoria(tipo, nivel)
	if not custo then
		Game.notificar(estado.player, "info", "melhoria_max")
		return false
	end
	if not Game.gastar(estado, custo) then
		Game.notificar(estado.player, "ruim", "melhoria_falta", Game.dinheiroTexto(custo))
		return false
	end
	estado.melhorias[tipo] = nivel + 1
	Game.atualizarBase(estado)
	Game.atualizarAtributos(estado)
	Game.notificar(estado.player, "bom", "melhorou", function(idioma)
		return Textos.t(idioma, "melhoria_" .. tipo)
	end, nivel + 1)
	Game.efeito("melhoria", estado.base.quadro.Position + Vector3.new(0, 14, 0), estado.base.cor)
	Game.emitir(estado, "melhorar", 1)
	return true
end

-- Índice: completar uma raridade dá +5% para sempre -------------------------
local function raridadeCompleta(estado, raridade)
	for _, def in ipairs(Config.robosDaRaridade(raridade)) do
		if not estado.descobertos[def.id] then
			return false
		end
	end
	return true
end

function Progresso.conferirIndice(estado, avisar)
	local ganhou = false
	for raridade = 1, #Config.Raridades do
		local chave = tostring(raridade)
		if not estado.indicePremios[chave] and raridadeCompleta(estado, raridade) then
			estado.indicePremios[chave] = true
			ganhou = true
			if avisar then
				Game.notificar(estado.player, "bom", "indice_completo", Game.nomeRaridade(raridade))
				Game.remotos.Efeito:FireClient(estado.player, "premio")
			end
		end
	end
	if ganhou then
		Game.atualizarAtributos(estado)
	end
end

-- Bônus: amigos, grupo e Premium ---------------------------------------------
local amizades = {} -- [userIdA .. ":" .. userIdB] = true/false

local function saoAmigos(a, b)
	local chave = math.min(a.UserId, b.UserId) .. ":" .. math.max(a.UserId, b.UserId)
	if amizades[chave] == nil then
		local ok, resultado = pcall(function()
			return a:IsFriendsWithAsync(b.UserId)
		end)
		amizades[chave] = ok and resultado == true
	end
	return amizades[chave]
end

function Progresso.atualizarAmigos()
	for player, estado in pairs(Game.estados) do
		local n = 0
		for outroPlayer in pairs(Game.estados) do
			if outroPlayer ~= player and saoAmigos(player, outroPlayer) then
				n = n + 1
			end
		end
		if estado.amigos ~= n and Game.estados[player] == estado then
			estado.amigos = n
			Game.atualizarAtributos(estado)
		end
	end
end

function Progresso.conferirGrupo(estado)
	if Config.GRUPO.ID == 0 then
		return
	end
	local ok, noGrupo = pcall(function()
		return estado.player:IsInGroupAsync(Config.GRUPO.ID)
	end)
	if not ok or Game.estados[estado.player] ~= estado then
		return
	end
	estado.noGrupo = noGrupo == true
	estado.player:SetAttribute("NoGrupo", estado.noGrupo)
	if estado.noGrupo and not estado.dados.grupoPremiado then
		estado.dados.grupoPremiado = true
		local def = Config.sortearDaRaridade(Config.GRUPO.RARIDADE_PREMIO, Game.aleatorio())
		Game.darRobo(estado, def, nil)
		Game.notificar(estado.player, "bom", "grupo_bonus", Game.nomeRaridade(Config.GRUPO.RARIDADE_PREMIO))
	end
	Game.atualizarAtributos(estado)
end

function Progresso.conferirPremium(estado)
	estado.premium = estado.player.MembershipType == Enum.MembershipType.Premium
	Game.atualizarAtributos(estado)
end

-- Atributos que a tela lê -----------------------------------------------------
function Progresso.atualizarAtributos(estado)
	local player = estado.player
	local dia, pronto = Progresso.situacaoDiario(estado)
	player:SetAttribute("DiarioDia", dia)
	player:SetAttribute("DiarioPronto", pronto)
	garantirMissoes(estado)
	local m = estado.dados.missoes
	player:SetAttribute("MissoesDia", diaAtual())
	for i = 1, Config.MISSOES_POR_DIA do
		local missao = estado.missoesDoDia[i]
		player:SetAttribute("M" .. i .. "Id", missao and missao.id or "")
		player:SetAttribute("M" .. i .. "Prog", missao and (tonumber(m.progresso[missao.id]) or 0) or 0)
		player:SetAttribute("M" .. i .. "Pega", missao and m.pegas[missao.id] == true or false)
	end
end

-- Entrada, saída e relógio ----------------------------------------------------
function Progresso.aoEntrar(estado)
	garantirMissoes(estado)
	Progresso.conferirIndice(estado, false)
	Progresso.conferirPremium(estado)
	estado.offlinePendente = Progresso.calcularOffline(estado)
	estado.player:SetAttribute("OfflinePendente", estado.offlinePendente)
	Progresso.atualizarAtributos(estado)
	task.spawn(Progresso.atualizarAmigos)
	task.spawn(Progresso.conferirGrupo, estado)
end

-- Quem sai sem pegar o dinheiro offline não perde: entra direto na conta.
function Progresso.aoSair(estado)
	if (estado.offlinePendente or 0) > 0 then
		Game.adicionarDinheiro(estado, estado.offlinePendente)
		estado.offlinePendente = 0
	end
end

local minutos = 0
function Progresso.cadaMinuto()
	minutos = minutos + 1
	for _, estado in pairs(Game.estados) do
		local diaAntes = estado.diaMissoes
		Game.emitir(estado, "minutos", 1)
		garantirMissoes(estado)
		if diaAntes ~= estado.diaMissoes then
			Progresso.atualizarAtributos(estado)
		end
	end
	if minutos % 3 == 0 then
		for _, estado in pairs(Game.estados) do
			task.spawn(Progresso.conferirGrupo, estado)
		end
	end
end

function Progresso.iniciar()
	table.insert(Game.ouvintes, Progresso.contar)
	Game.aoDescobrir = function(estado)
		Progresso.conferirIndice(estado, true)
	end
	Players.PlayerMembershipChanged:Connect(function(player)
		local estado = Game.estados[player]
		if estado then
			Progresso.conferirPremium(estado)
		end
	end)
end

return Progresso
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000A"><Properties><string name="Name">Ranking</string><ProtectedString name="Source"><![CDATA[--[[
	Ranking global: os 10 jogadores que mais ganharam dinheiro no total
	(somando todas as partidas, mesmo depois de renascer). Fica no quadro
	ao lado da esteira e é atualizado a cada 2 minutos.

	Usa um OrderedDataStore. No Studio sem acesso às APIs, o quadro só
	mostra "Carregando...".
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local Ranking = {}

local LINHAS = 10
local nomes = {} -- cache de userId -> nome

local ordenado = nil
pcall(function()
	ordenado = DataStoreService:GetOrderedDataStore("RankingTotal_v1")
end)

function Ranking.registrar(player, totalGanho)
	if not ordenado then
		return
	end
	local valor = math.floor(math.min(tonumber(totalGanho) or 0, 9e18))
	pcall(function()
		ordenado:SetAsync("u_" .. player.UserId, valor)
	end)
end

local function nomeDe(userId)
	if nomes[userId] then
		return nomes[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nomes[userId] = player.DisplayName
		return nomes[userId]
	end
	local ok, nome = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and type(nome) == "string" then
		nomes[userId] = nome
		return nome
	end
	return "?"
end

-- Escreve os resultados como atributos no quadro; cada jogador desenha
-- no seu idioma (R1Nome, R1Valor, ..., RTotal).
function Ranking.atualizar(quadro)
	if not ordenado or not quadro then
		return
	end
	local ok, pagina = pcall(function()
		return ordenado:GetSortedAsync(false, LINHAS):GetCurrentPage()
	end)
	if not ok or type(pagina) ~= "table" then
		return
	end
	local total = 0
	for i, entrada in ipairs(pagina) do
		if i > LINHAS then
			break
		end
		local userId = tonumber(string.sub(tostring(entrada.key), 3))
		if userId then
			total = total + 1
			quadro:SetAttribute("R" .. total .. "Nome", nomeDe(userId))
			quadro:SetAttribute("R" .. total .. "Valor", tonumber(entrada.value) or 0)
		end
	end
	quadro:SetAttribute("RTotal", total)
end

return Ranking
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000B"><Properties><string name="Name">RobotFactory</string><ProtectedString name="Source"><![CDATA[--[[
	Monta o modelo 3D de cada robô com peças simples (sem malhas ou
	imagens enviadas). Robôs mais raros ficam maiores e ganham faíscas,
	luz, asas e auréola. A mutação muda a cor e o material.

	O modelo é montado com os pés na origem; quem chama usa
	modelo:PivotTo(cframe). A placa em cima da cabeça recebe os textos no
	idioma de cada jogador (atributos RoboId/Mut + tag "RoboInfo").
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local RobotFactory = {}

local CONTORNO = Color3.fromRGB(20, 23, 43)
local FAISCAS = "rbxasset://textures/particles/sparkles_main.dds"

local function novaParte(modelo, nome, tamanho, cframe, cor, material, forma)
	local parte = Instance.new("Part")
	parte.Name = nome
	if forma then
		parte.Shape = forma
	end
	parte.Size = tamanho
	parte.CFrame = cframe
	parte.Color = cor
	parte.Material = material or Enum.Material.SmoothPlastic
	parte.TopSurface = Enum.SurfaceType.Smooth
	parte.BottomSurface = Enum.SurfaceType.Smooth
	parte.Anchored = true
	parte.CanCollide = false
	parte.CanTouch = false
	parte.Parent = modelo
	return parte
end

local function rotulo(pai, nome, texto, cor, ordem, altura, fonte)
	local r = Instance.new("TextLabel")
	r.Name = nome
	r.BackgroundTransparency = 1
	r.Size = UDim2.new(1, 0, 0, altura or 18)
	r.Text = texto
	r.TextColor3 = cor
	r.TextStrokeTransparency = 0
	r.TextStrokeColor3 = CONTORNO
	r.TextScaled = true
	r.Font = fonte or Enum.Font.FredokaOne
	r.LayoutOrder = ordem
	r.Parent = pai
	return r
end

local function faiscas(parte, cor, taxa)
	local emissor = Instance.new("ParticleEmitter")
	emissor.Name = "Faiscas"
	emissor.Texture = FAISCAS
	emissor.Color = ColorSequence.new(cor)
	emissor.LightEmission = 1
	emissor.LightInfluence = 0
	emissor.Rate = taxa
	emissor.Lifetime = NumberRange.new(0.8, 1.4)
	emissor.Speed = NumberRange.new(1, 2.5)
	emissor.SpreadAngle = Vector2.new(180, 180)
	emissor.Size = NumberSequence.new(0.35, 0)
	emissor.Parent = parte
	return emissor
end

function RobotFactory.construir(robo, mutacaoId)
	local raridade = Config.Raridades[robo.raridade]
	local mutacao = mutacaoId and Config.MutacaoPorId[mutacaoId] or nil
	local s = raridade.escala

	local corPrincipal = robo.cor
	local materialPrincipal = Enum.Material.SmoothPlastic
	local reflexo = 0
	local transparencia = 0
	if mutacao and mutacao.id == "dourado" then
		corPrincipal = mutacao.cor
		materialPrincipal = Enum.Material.Metal
		reflexo = 0.3
	elseif mutacao and mutacao.id == "diamante" then
		corPrincipal = mutacao.cor
		materialPrincipal = Enum.Material.Glass
		reflexo = 0.2
		transparencia = 0.15
	elseif mutacao and mutacao.id == "arcoiris" then
		corPrincipal = mutacao.cor
		materialPrincipal = Enum.Material.Neon
	end
	local corDetalhe = robo.detalhe
	local corBrilho = raridade.cor
	local corOlhos = Color3.fromRGB(125, 249, 255)
	if robo.raridade >= 7 then
		corOlhos = robo.detalhe
	end
	local corBarriga = corPrincipal:Lerp(Color3.new(1, 1, 1), 0.35)

	local modelo = Instance.new("Model")
	modelo.Name = robo.id
	modelo:SetAttribute("RoboId", robo.id)
	if mutacaoId then
		modelo:SetAttribute("Mut", mutacaoId)
	end

	-- raiz invisível nos pés: o ponto de referência do modelo
	local raiz = novaParte(modelo, "Raiz", Vector3.new(0.4, 0.4, 0.4), CFrame.new(0, 0, 0), corDetalhe)
	raiz.Transparency = 1
	modelo.PrimaryPart = raiz

	-- pés e pernas
	for _, lado in ipairs({ -1, 1 }) do
		novaParte(modelo, "Pe", Vector3.new(0.9, 0.4, 1.2) * s, CFrame.new(0.6 * lado * s, 0.2 * s, -0.1 * s), corDetalhe)
		novaParte(modelo, "Perna", Vector3.new(0.55, 1.0, 0.55) * s, CFrame.new(0.6 * lado * s, 0.9 * s, 0), CONTORNO)
	end

	-- corpo
	local alturaCorpo, larguraCorpo
	local corpo
	local yBaseCorpo = 1.3
	if robo.forma == "barril" then
		alturaCorpo, larguraCorpo = 2.2, 2.2
		corpo = novaParte(modelo, "Corpo", Vector3.new(alturaCorpo, larguraCorpo, larguraCorpo) * s,
			CFrame.new(0, (yBaseCorpo + alturaCorpo / 2) * s, 0) * CFrame.Angles(0, 0, math.pi / 2),
			corPrincipal, materialPrincipal, Enum.PartType.Cylinder)
	elseif robo.forma == "bola" then
		alturaCorpo, larguraCorpo = 2.4, 2.4
		corpo = novaParte(modelo, "Corpo", Vector3.new(2.4, 2.4, 2.4) * s,
			CFrame.new(0, (yBaseCorpo - 0.1 + alturaCorpo / 2) * s, 0), corPrincipal, materialPrincipal, Enum.PartType.Ball)
	else
		alturaCorpo, larguraCorpo = 2, 2.4
		corpo = novaParte(modelo, "Corpo", Vector3.new(larguraCorpo, alturaCorpo, 1.8) * s,
			CFrame.new(0, (yBaseCorpo + alturaCorpo / 2) * s, 0), corPrincipal, materialPrincipal)
	end
	corpo.Reflectance = reflexo
	corpo.Transparency = transparencia
	local yCorpo = (yBaseCorpo + alturaCorpo / 2) * s
	local topoCorpo = (yBaseCorpo + alturaCorpo) * s
	local frenteCorpo = -(larguraCorpo / 2) * s
	if robo.forma == "caixa" then
		frenteCorpo = -0.9 * s
	end

	-- placa da barriga
	novaParte(modelo, "Barriga", Vector3.new(1.2, 0.9, 0.12) * s,
		CFrame.new(0, yCorpo - 0.15 * s, frenteCorpo - 0.02 * s), corBarriga)

	-- braços: ombro, braço e mão
	for _, lado in ipairs({ -1, 1 }) do
		local xOmbro = (larguraCorpo / 2 + 0.15) * lado * s
		novaParte(modelo, "Ombro", Vector3.new(0.7, 0.7, 0.7) * s, CFrame.new(xOmbro, topoCorpo - 0.45 * s, 0),
			corDetalhe, nil, Enum.PartType.Ball)
		novaParte(modelo, "Braco", Vector3.new(0.45, 1.3, 0.45) * s,
			CFrame.new(xOmbro + 0.15 * lado * s, yCorpo - 0.25 * s, 0) * CFrame.Angles(0, 0, 0.2 * lado), CONTORNO)
		novaParte(modelo, "Mao", Vector3.new(0.6, 0.6, 0.6) * s,
			CFrame.new(xOmbro + 0.3 * lado * s, yCorpo - 0.95 * s, 0), corDetalhe, nil, Enum.PartType.Ball)
	end

	-- cabeça, visor, olhos e antena (a frente do robô é o -Z)
	local yCabeca = topoCorpo + 0.7 * s
	local cabeca = novaParte(modelo, "Cabeca", Vector3.new(1.8, 1.3, 1.5) * s,
		CFrame.new(0, yCabeca, 0), corPrincipal, materialPrincipal)
	cabeca.Reflectance = reflexo
	cabeca.Transparency = transparencia
	novaParte(modelo, "Visor", Vector3.new(1.4, 0.65, 0.1) * s,
		CFrame.new(0, yCabeca + 0.08 * s, -0.78 * s), CONTORNO)
	for _, lado in ipairs({ -1, 1 }) do
		novaParte(modelo, "Olho", Vector3.new(0.32, 0.32, 0.1) * s,
			CFrame.new(0.32 * lado * s, yCabeca + 0.1 * s, -0.84 * s), corOlhos, Enum.Material.Neon)
	end
	local topoCabeca = yCabeca + 0.65 * s
	novaParte(modelo, "Antena", Vector3.new(0.12, 0.8, 0.12) * s,
		CFrame.new(0, topoCabeca + 0.4 * s, 0), CONTORNO)
	local ponta = novaParte(modelo, "PontaAntena", Vector3.new(0.42, 0.42, 0.42) * s,
		CFrame.new(0, topoCabeca + 0.9 * s, 0), corBrilho, Enum.Material.Neon, Enum.PartType.Ball)

	-- extras por raridade
	if robo.raridade >= 4 then
		novaParte(modelo, "LuzPeito", Vector3.new(0.45, 0.45, 0.1) * s,
			CFrame.new(0, yCorpo - 0.15 * s, frenteCorpo - 0.1 * s), corBrilho, Enum.Material.Neon)
		faiscas(ponta, corBrilho, robo.raridade >= 6 and 6 or 3)
	end
	if robo.raridade >= 5 then
		local luz = Instance.new("PointLight")
		luz.Color = corBrilho
		luz.Range = 10 * s
		luz.Brightness = 2
		luz.Parent = corpo
	end
	if robo.raridade >= 6 then
		for _, lado in ipairs({ -1, 1 }) do
			novaParte(modelo, "Asa", Vector3.new(0.2, 1.9, 1.5) * s,
				CFrame.new(1.1 * lado * s, yCorpo + 0.5 * s, 1.0 * s) * CFrame.Angles(0, 0.5 * lado, 0.35 * lado),
				corDetalhe, Enum.Material.Neon)
		end
	end
	if robo.raridade >= 7 then
		local aureola = novaParte(modelo, "Aureola", Vector3.new(0.15, 1.9, 1.9) * s,
			CFrame.new(0, topoCabeca + 1.5 * s, 0) * CFrame.Angles(0, 0, math.pi / 2),
			corBrilho, Enum.Material.Neon, Enum.PartType.Cylinder)
		aureola.Transparency = 0.3
	end

	if mutacao and mutacao.id == "arcoiris" then
		CollectionService:AddTag(corpo, "Arcoiris")
		CollectionService:AddTag(cabeca, "Arcoiris")
		faiscas(corpo, Color3.fromRGB(255, 255, 255), 4)
	elseif mutacao and mutacao.id == "dourado" then
		faiscas(cabeca, mutacao.cor, 2)
	end

	-- placa de informações em cima da cabeça
	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Adornee = cabeca
	gui.Size = UDim2.fromOffset(220, 104)
	gui.StudsOffset = Vector3.new(0, 1.3 * s + 2.4, 0)
	gui.MaxDistance = 70
	gui.LightInfluence = 0
	gui.Parent = raiz

	local lista = Instance.new("UIListLayout")
	lista.SortOrder = Enum.SortOrder.LayoutOrder
	lista.HorizontalAlignment = Enum.HorizontalAlignment.Center
	lista.VerticalAlignment = Enum.VerticalAlignment.Bottom
	lista.Parent = gui

	if mutacao then
		rotulo(gui, "Mutacao", mutacao.en, mutacao.cor, 1, 16, Enum.Font.LuckiestGuy)
	end
	rotulo(gui, "Nome", robo.en, Color3.new(1, 1, 1), 2, 22)
	rotulo(gui, "Raridade", raridade.en, raridade.cor, 3, 17)
	local rotuloPreco = rotulo(gui, "Preco", Format.dinheiro(Config.precoDe(robo, mutacaoId), "en"),
		Color3.fromRGB(75, 240, 138), 4, 19)
	local rotuloRenda = rotulo(gui, "Renda", Format.dinheiro(Config.rendaDe(robo, mutacaoId), "en") .. "/s",
		Color3.fromRGB(255, 216, 77), 5, 16)
	CollectionService:AddTag(gui, "RoboInfo")

	-- o botão "segure E" do robô (texto traduzido no jogador)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Interagir"
	prompt.ActionText = "Buy"
	prompt.ObjectText = Config.nomeCompleto(robo, mutacaoId, "en") .. " — " .. Format.dinheiro(Config.precoDe(robo, mutacaoId), "en")
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt:SetAttribute("Robo", true)
	prompt:SetAttribute("RoboId", robo.id)
	if mutacaoId then
		prompt:SetAttribute("Mut", mutacaoId)
	end
	prompt.Parent = corpo

	return {
		modelo = modelo,
		raiz = raiz,
		corpo = corpo,
		prompt = prompt,
		rotuloPreco = rotuloPreco,
		rotuloRenda = rotuloRenda,
	}
end

return RobotFactory
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000C"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[--[[
	Loja com Robux: passes (compra única), produtos (pacotes de dinheiro,
	sorte do servidor, caixa surpresa) e o anúncio com prêmio.

	Só funciona depois que você cria os itens no Creator Hub e cola os
	números em Config.LOJA. Itens com id = 0 ficam desligados.

	Cada compra é entregue uma única vez: o número da compra (PurchaseId)
	fica guardado no save do jogador, então mesmo que o Roblox repita o
	aviso, ninguém recebe em dobro.
]]

local AdService = game:GetService("AdService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Textos = require(Shared:WaitForChild("Textos"))
local Game = require(script.Parent:WaitForChild("Game"))
local Conveyor = require(script.Parent:WaitForChild("Conveyor"))
local Progresso = require(script.Parent:WaitForChild("Progresso"))

local Shop = {}

Shop.aoComprar = nil -- function(estado): o Main usa para salvar na hora

local MAX_COMPRAS_GUARDADAS = 50

local passePorId = {}
for _, passe in ipairs(Config.LOJA.PASSES) do
	if passe.id ~= 0 then
		passePorId[passe.id] = passe.chave
	end
end

local function nomePasse(chave)
	return function(idioma)
		return Textos.t(idioma, "passe_" .. chave)
	end
end

-- Passes ---------------------------------------------------------------------

-- Liga os efeitos dos passes que o jogador tem (vale também ao comprar agora)
local function aplicarPasses(estado)
	if estado.passes.vip and not estado.dados.vipPremiado then
		estado.dados.vipPremiado = true
		local def = Config.sortearDaRaridade(Config.LOJA.VIP_ROBO_RARIDADE, Game.aleatorio())
		Game.darRobo(estado, def, nil)
		Game.notificar(estado.player, "bom", "vip_robo", Game.nomeRobo(def, nil))
	end
	if Game.etiquetaVip then
		Game.etiquetaVip(estado)
	end
	Game.atualizarBase(estado)
	Game.atualizarAtributos(estado)
end

-- Confere no Roblox quais passes o jogador tem. Chamado ao entrar.
function Shop.verificarPasses(estado)
	for _, passe in ipairs(Config.LOJA.PASSES) do
		if passe.id ~= 0 then
			local ok, tem = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(estado.player.UserId, passe.id)
			end)
			if ok and tem then
				estado.passes[passe.chave] = true
			end
		end
	end
end

function Shop.aplicarPasses(estado)
	aplicarPasses(estado)
end

-- Países que proíbem sorteio pago não veem a caixa surpresa.
-- Se não der para saber, esconde (é o lado seguro).
function Shop.verificarPolitica(estado)
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(estado.player)
	end)
	local restrito = true
	if ok and type(info) == "table" then
		restrito = info.ArePaidRandomItemsRestricted == true
	end
	estado.semCaixa = restrito
	estado.player:SetAttribute("SemCaixa", restrito)
end

-- Produtos -------------------------------------------------------------------

local function pacotePorId(id)
	for _, pacote in ipairs(Config.LOJA.PACOTES) do
		if pacote.id ~= 0 and pacote.id == id then
			return pacote
		end
	end
	return nil
end

-- Entrega o produto. Retorna false se o número não é de nenhum produto.
local function entregar(estado, produtoId)
	local player = estado.player
	local pacote = pacotePorId(produtoId)
	if pacote then
		local valor = Config.dinheiroDe(pacote, Game.rendaPorSegundo(estado))
		Game.adicionarDinheiro(estado, valor)
		Game.notificar(player, "bom", "compra_ok", Game.dinheiroTexto(valor))
		Game.remotos.Efeito:FireClient(player, "premio")
		return true
	end
	local loja = Config.LOJA
	if loja.SORTE.id ~= 0 and produtoId == loja.SORTE.id then
		Conveyor.iniciarSorte(loja.SORTE.minutos * 60, player.DisplayName)
		return true
	end
	if loja.CAIXA.id ~= 0 and produtoId == loja.CAIXA.id then
		local def, mut = Config.sortearCaixa(Game.aleatorio())
		Game.notificar(player, "bom", "caixa", Game.nomeRobo(def, mut), Game.nomeRaridade(def.raridade))
		Game.darRobo(estado, def, mut)
		Game.remotos.Efeito:FireClient(player, "caixa", nil, Config.Raridades[def.raridade].cor)
		return true
	end
	if loja.ANUNCIO.id ~= 0 and produtoId == loja.ANUNCIO.id then
		if estado.anuncioMotivo == "offline" and (estado.offlinePendente or 0) > 0 then
			Progresso.coletarOffline(estado, true)
		else
			estado.dobroAte = math.max(Game.agora(), estado.dobroAte) + loja.ANUNCIO.minutos * 60
			Game.atualizarAtributos(estado)
			Game.notificar(player, "bom", "anuncio_ok", Game.tempoTexto(estado.dobroAte - Game.agora()))
		end
		estado.anuncioMotivo = nil
		return true
	end
	return false
end

local function jaEntregue(estado, compraId)
	for _, id in ipairs(estado.dados.compras) do
		if id == compraId then
			return true
		end
	end
	return false
end

local function processarCompra(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local estado = player and Game.estados[player]
	if not estado then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local compraId = tostring(info.PurchaseId)
	if jaEntregue(estado, compraId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	if not entregar(estado, info.ProductId) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local compras = estado.dados.compras
	table.insert(compras, compraId)
	while #compras > MAX_COMPRAS_GUARDADAS do
		table.remove(compras, 1)
	end
	if Shop.aoComprar then
		Shop.aoComprar(estado)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Anúncio com prêmio -----------------------------------------------------------
-- motivo: "dobro" (x2 por 10 min) ou "offline" (dobra o dinheiro offline).
-- O prêmio chega pelo ProcessReceipt do produto do anúncio.
function Shop.verAnuncio(estado, motivo)
	local id = Config.LOJA.ANUNCIO.id
	if id == 0 or (motivo ~= "dobro" and motivo ~= "offline") then
		return false
	end
	estado.anuncioMotivo = motivo
	local ok, resultado = pcall(function()
		local premio = AdService:CreateAdRewardFromDevProductId(id)
		return AdService:ShowRewardedVideoAdAsync(estado.player, premio)
	end)
	if not ok or resultado ~= Enum.ShowAdResult.ShowCompleted then
		estado.anuncioMotivo = nil
		if not ok or resultado ~= Enum.ShowAdResult.ShowInterrupted then
			Game.notificar(estado.player, "info", "anuncio_indisponivel")
		end
		return false
	end
	return true
end

function Shop.iniciar()
	MarketplaceService.ProcessReceipt = processarCompra
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passeId, comprou)
		local estado = Game.estados[player]
		local chave = passePorId[passeId]
		if comprou and estado and chave then
			estado.passes[chave] = true
			aplicarPasses(estado)
			Game.notificar(player, "bom", "passe_ok", nomePasse(chave))
			Game.remotos.Efeito:FireClient(player, "premio")
		end
	end)
end

return Shop
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000D"><Properties><string name="Name">Stealing</string><ProtectedString name="Source"><![CDATA[--[[
	Roubo, venda e o Tapa.

	Como funciona o roubo:
	  1. O ladrão entra numa base destrancada e segura E num robô.
	  2. O robô vai para cima da cabeça dele e ele fica mais lento.
	  3. Se chegar na PRÓPRIA base, o robô passa a ser dele.
	  4. Se levar um tapa, morrer, sair do jogo ou demorar demais,
	     o robô volta voando para o dono.
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Game = require(script.Parent:WaitForChild("Game"))
local MapBuilder = require(script.Parent:WaitForChild("MapBuilder"))

local Stealing = {}

local ladroes = {} -- [estadoDoLadrao] = true

local function partesDo(robo)
	local partes = {}
	for _, item in ipairs(robo.modelo:GetDescendants()) do
		if item:IsA("BasePart") then
			table.insert(partes, item)
		end
	end
	return partes
end

local function nomeDo(robo)
	return Game.nomeRobo(robo.def, robo.mut)
end

-- Venda ------------------------------------------------------------------------

function Stealing.vender(estado, robo)
	local valor = Game.valorVenda(robo)
	local nome = nomeDo(robo)
	Game.destruirRobo(robo)
	Game.adicionarDinheiro(estado, valor)
	Game.atualizarAtributos(estado)
	Game.notificar(estado.player, "info", "vendeu", nome, Game.dinheiroTexto(valor))
	Game.emitir(estado, "vender", 1)
end

-- Roubo ------------------------------------------------------------------------

function Stealing.roubar(ladrao, robo)
	local dono = robo.dono
	local player = ladrao.player
	local raiz, humanoid = Game.raizDe(player)
	if not raiz or not dono then
		return
	end
	if ladrao.carregando then
		Game.notificar(player, "ruim", "ja_carregando")
		return
	end
	if Game.trancada(dono) then
		Game.notificar(player, "ruim", "base_trancada_roubo")
		return
	end
	if not MapBuilder.dentroDaBase(dono.base, raiz.Position, 2) then
		return
	end
	if not Game.vagaLivre(ladrao) then
		Game.notificar(player, "ruim", "base_cheia_roubo")
		return
	end

	robo.estado = "carregado"
	robo.ladrao = ladrao
	robo.inicioRoubo = os.clock()
	robo.voo = robo.voo + 1
	robo.prompt.Enabled = false
	ladrao.carregando = robo
	ladroes[ladrao] = true

	-- prende o robô em cima da cabeça do ladrão
	local partes = partesDo(robo)
	local raizRobo = robo.visual.raiz
	robo.modelo:PivotTo(raiz.CFrame * CFrame.new(0, 3.2, 0))
	local soldas = Instance.new("Folder")
	soldas.Name = "Soldas"
	for _, parte in ipairs(partes) do
		if parte ~= raizRobo then
			local solda = Instance.new("WeldConstraint")
			solda.Part0 = raizRobo
			solda.Part1 = parte
			solda.Parent = soldas
		end
	end
	local soldaNaCabeca = Instance.new("WeldConstraint")
	soldaNaCabeca.Part0 = raiz
	soldaNaCabeca.Part1 = raizRobo
	soldaNaCabeca.Parent = soldas
	soldas.Parent = robo.modelo
	for _, parte in ipairs(partes) do
		parte.Massless = true
		parte.Anchored = false
	end

	humanoid.WalkSpeed = Config.ROUBO.VELOCIDADE_CARREGANDO
	player:SetAttribute("Carregando", robo.def.id)
	player:SetAttribute("CarregandoMut", robo.mut or "")
	robo.conexaoMorte = humanoid.Died:Connect(function()
		Stealing.falhar(ladrao, "caiu")
	end)

	Game.notificar(player, "bom", "pegou", nomeDo(robo))
	Game.notificar(dono.player, "alerta", "alerta_roubo", player.DisplayName, nomeDo(robo))
	Game.remotos.Efeito:FireClient(dono.player, "alarme", dono.base.barreira.Position, Color3.fromRGB(255, 59, 59))
end

-- Solta o robô da cabeça do ladrão (não decide para onde ele vai).
function Stealing.desprender(robo)
	if robo.conexaoMorte then
		robo.conexaoMorte:Disconnect()
		robo.conexaoMorte = nil
	end
	for _, parte in ipairs(partesDo(robo)) do
		parte.Anchored = true
		parte.Massless = false
	end
	local soldas = robo.modelo:FindFirstChild("Soldas")
	if soldas then
		soldas:Destroy()
	end

	local ladrao = robo.ladrao
	if ladrao then
		ladrao.carregando = nil
		ladroes[ladrao] = nil
		ladrao.player:SetAttribute("Carregando", nil)
		ladrao.player:SetAttribute("CarregandoMut", nil)
		local _, humanoid = Game.raizDe(ladrao.player)
		if humanoid then
			humanoid.WalkSpeed = Config.ROUBO.VELOCIDADE_NORMAL
		end
	end
	robo.ladrao = nil
	if robo.estado == "carregado" then
		robo.estado = "solto"
	end
end

-- O roubo deu errado: o robô volta para o dono. motivo = chave de texto (ou nil)
function Stealing.falhar(ladrao, motivo, ...)
	local robo = ladrao.carregando
	if not robo then
		return
	end
	Stealing.desprender(robo)

	local dono = robo.dono
	if dono and not dono.saindo and robo.vaga and dono.vagas[robo.vaga] == robo then
		Game.colocarNaBase(dono, robo, robo.vaga, false)
		Game.notificar(dono.player, "bom", "voltou_base", nomeDo(robo))
	else
		Game.destruirRobo(robo)
	end
	if motivo then
		Game.notificar(ladrao.player, "ruim", motivo, ...)
	end
end

-- O ladrão chegou na própria base.
function Stealing.entregar(ladrao)
	local robo = ladrao.carregando
	if not robo then
		return
	end
	local vaga = Game.vagaLivre(ladrao)
	if not vaga then
		Stealing.falhar(ladrao, "base_cheia_entrega")
		return
	end
	local dono = robo.dono
	local nome = nomeDo(robo)
	Stealing.desprender(robo)
	Game.tirarDaBase(robo)
	Game.colocarNaBase(ladrao, robo, vaga, false)

	Game.notificar(ladrao.player, "bom", "roubou", nome)
	Game.emitir(ladrao, "roubar", 1)
	if dono then
		Game.notificar(dono.player, "ruim", "foi_roubado", ladrao.player.DisplayName, nome)
	end
end

function Stealing.vigiar()
	for ladrao in pairs(ladroes) do
		local robo = ladrao.carregando
		if not robo then
			ladroes[ladrao] = nil
		else
			local raiz = Game.raizDe(ladrao.player)
			if not raiz then
				Stealing.falhar(ladrao, "caiu")
			elseif os.clock() - robo.inicioRoubo > Config.ROUBO.TEMPO_MAXIMO then
				Stealing.falhar(ladrao, "demorou")
			elseif MapBuilder.dentroDaBase(ladrao.base, raiz.Position, -1) then
				Stealing.entregar(ladrao)
			end
		end
	end
end

-- Tapa -------------------------------------------------------------------------

function Stealing.darTapa(player)
	local mochila = player:FindFirstChildOfClass("Backpack")
	local personagem = player.Character
	if not mochila then
		return
	end
	if mochila:FindFirstChild("Tapa") or (personagem and personagem:FindFirstChild("Tapa")) then
		return
	end

	local ferramenta = Instance.new("Tool")
	ferramenta.Name = "Tapa"
	ferramenta.ToolTip = "Slap! / Tapa!"
	ferramenta.CanBeDropped = false
	ferramenta.RequiresHandle = true

	local mao = Instance.new("Part")
	mao.Name = "Handle"
	mao.Shape = Enum.PartType.Ball
	mao.Size = Vector3.new(1.3, 1.3, 1.3)
	mao.Color = Color3.fromRGB(230, 50, 50)
	mao.Material = Enum.Material.SmoothPlastic
	mao.CanCollide = false
	mao.Massless = true
	mao.Parent = ferramenta

	ferramenta.Activated:Connect(function()
		Stealing.tapa(player)
	end)
	ferramenta.Parent = mochila
end

local function efeitoDeTapa(posicao)
	local estouro = Instance.new("Part")
	estouro.Name = "Pa"
	estouro.Shape = Enum.PartType.Ball
	estouro.Size = Vector3.new(3, 3, 3)
	estouro.CFrame = CFrame.new(posicao)
	estouro.Anchored = true
	estouro.CanCollide = false
	estouro.CanTouch = false
	estouro.CanQuery = false
	estouro.Material = Enum.Material.Neon
	estouro.Color = Color3.fromRGB(255, 255, 200)
	estouro.Transparency = 0.3
	estouro.Parent = workspace
	Debris:AddItem(estouro, 0.2)
end

function Stealing.tapa(player)
	local estado = Game.estados[player]
	if not estado then
		return
	end
	local instante = os.clock()
	if instante - estado.ultimoTapa < Config.TAPA.RECARGA then
		return
	end
	estado.ultimoTapa = instante

	local raiz = Game.raizDe(player)
	if not raiz then
		return
	end

	local alvo, raizAlvo, melhor = nil, nil, math.huge
	for outroPlayer, outro in pairs(Game.estados) do
		if outro ~= estado then
			local outraRaiz = Game.raizDe(outroPlayer)
			if outraRaiz then
				local delta = outraRaiz.Position - raiz.Position
				local distancia = delta.Magnitude
				if distancia <= Config.TAPA.ALCANCE and distancia < melhor then
					if distancia < 3 or raiz.CFrame.LookVector:Dot(delta.Unit) > 0.2 then
						alvo, raizAlvo, melhor = outro, outraRaiz, distancia
					end
				end
			end
		end
	end
	if not alvo then
		return
	end

	local direcao = (raizAlvo.Position - raiz.Position) * Vector3.new(1, 0, 1)
	if direcao.Magnitude < 0.1 then
		direcao = raiz.CFrame.LookVector
	end
	direcao = direcao.Unit
	local forca = Config.TAPA.FORCA + Config.TAPA.FORCA_POR_NIVEL * estado.melhorias.tapa
	Game.remotos.Empurrao:FireClient(alvo.player, direcao * forca)
	efeitoDeTapa(raizAlvo.Position)
	Game.efeito("tapa", raizAlvo.Position, Color3.fromRGB(255, 255, 200))

	if alvo.carregando then
		local nome = nomeDo(alvo.carregando)
		Stealing.falhar(alvo, "tapa_soltou", player.DisplayName)
		Game.notificar(player, "bom", "tapa_acertou", alvo.player.DisplayName, nome)
		Game.emitir(estado, "tapaLadrao", 1)
	end
end

-- Liga tudo ------------------------------------------------------------------

function Stealing.iniciar()
	Game.acoes.base = function(robo, player)
		local estado = Game.estados[player]
		if not estado or robo.estado ~= "base" then
			return
		end
		if robo.dono == estado then
			Stealing.vender(estado, robo)
		else
			Stealing.roubar(estado, robo)
		end
	end

	-- o robô vai sumir enquanto alguém carrega (dono saiu ou renasceu)
	Game.aoDestruirCarregado = function(robo)
		local ladrao = robo.ladrao
		Stealing.desprender(robo)
		if ladrao then
			Game.notificar(ladrao.player, "info", "sumiu")
		end
	end

	-- o ladrão saiu do jogo com o robô na cabeça
	Game.aoSairComCarga = function(ladrao)
		Stealing.falhar(ladrao, nil)
	end
end

return Stealing
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000000000000000000000000000016"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000000000000000000000000000015"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000000000000000000000000000014"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX0000000000000000000000000000000E"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[--[[
	Interface do jogador (segue a prévia aprovada):
	  topo: dinheiro, estado da base, faixas (sorte, carga, x2) e avisos
	  esquerda: Loja, Índice, Melhorar, Renascer
	  direita: Prêmio diário, Missões, 2x grátis (anúncio)
	  painéis: Loja, Índice, Melhorar, Renascer, Prêmio, Missões, Bem-vindo de volta

	Dois jeitos de arrumar: "compacto" (celular/tela pequena) e "PC".
	Tudo é só desenho: quem decide compras, prêmios e dinheiro é o servidor.
]]

local MarketplaceService = game:GetService("MarketplaceService")
