	{ nome = "Incomum", en = "Uncommon", cor = Color3.fromRGB(74, 222, 128), peso = 25, escala = 1.1 },
	{ nome = "Raro", en = "Rare", cor = Color3.fromRGB(56, 189, 248), peso = 13, escala = 1.2 },
