		texto({ Size = UDim2.new(1, -6, 0.45, 0), Position = UDim2.new(0, 3, 0.5, 0), Text = math.floor(c.peso / totalPeso * 100 + 0.5) .. "%", TamanhoMax = 18, ZIndex = 15, Parent = celula })
