	{ id = "roubar1", tipo = "roubar", meta = 1, premio = { tipo = "dinheiro", minimo = 10000, minutos = 10 } },
	{ id = "roubar2", tipo = "roubar", meta = 2, premio = { tipo = "dinheiro", minimo = 20000, minutos = 15 } },
